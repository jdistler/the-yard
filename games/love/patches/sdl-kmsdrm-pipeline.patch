+/* Partycade: SDL_KMSDRM_TIMING=1 prints, every 300 swaps, the mean time of each step below (ms). */
+static int tm_on = -1, tm_n;
+static double tm_wait, tm_swap, tm_lock, tm_flip;
+static double tm_now(void) { return (double)SDL_GetPerformanceCounter() * 1000.0 / (double)SDL_GetPerformanceFrequency(); }
+
+/* Partycade: SDL_KMSDRM_PIPELINE=1. On the Mali-400, gbm_surface_lock_front_buffer waits for the GPU to finish
+   the frame (10-18 ms), so the CPU idled while the GPU drew. Here a frame is handed to EGL and only locked and
+   flipped at the next swap, so the CPU builds frame N+1 while the GPU draws N. If the surface has no free buffer
+   left for the next frame, the frame is finished at once, as before. */
+static int pipe_on = -1;
+static SDL_bool pipe_pending;
+
+/* Partycade: the first frame goes on the screen with drmModeSetCrtc, and on the Mali the buffer could still be
+   unfinished then: the screen showed black for one frame before the first picture (filmed with tools/cabview,
+   2026-10-27), a blink between the picture in /dev/fb0 and the program. Wait for the GPU, before that first
+   drmModeSetCrtc only (both swap paths). */
+static void kmsdrm_first_frame_finish(void)
+{
+    static void (*gl_finish)(void);
+    if (!gl_finish) {
+        gl_finish = (void (*)(void))SDL_GL_GetProcAddress("glFinish");
+    }
+    if (gl_finish) {
+        double a = tm_now();
+        gl_finish();
+        if (SDL_getenv("SDL_KMSDRM_DEBUG")) fprintf(stderr, "kmsdrm: first frame, glFinish waited %.2f ms\n", tm_now() - a);
+    } else if (SDL_getenv("SDL_KMSDRM_DEBUG")) {
+        fprintf(stderr, "kmsdrm: first frame, no glFinish\n");
+    }
+}
+
+static int KMSDRM_GLES_FinishPending(_THIS, SDL_Window *window)
+{
+    SDL_WindowData *windata = ((SDL_WindowData *)window->driverdata);
+    SDL_DisplayData *dispdata = (SDL_DisplayData *)SDL_GetDisplayForWindow(window)->driverdata;
+    SDL_VideoData *viddata = ((SDL_VideoData *)_this->driverdata);
+    KMSDRM_FBInfo *fb_info;
+    struct gbm_bo *bo;
+    int ret;
+    pipe_pending = SDL_FALSE;
+    bo = KMSDRM_gbm_surface_lock_front_buffer(windata->gs);
+    if (!bo) {
+        SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "Could not lock front buffer on GBM surface");
+        return 0;
+    }
+    fb_info = KMSDRM_FBFromBO(_this, bo);
+    if (!fb_info) {
+        return 0;
+    }
+    if (!KMSDRM_WaitPageflip(_this, windata)) {
+        return 0;
+    }
+    if (windata->bo) {
+        KMSDRM_gbm_surface_release_buffer(windata->gs, windata->bo);
+    }
+    windata->bo = windata->next_bo;
+    windata->next_bo = bo;
+    if (!windata->bo) {
+        kmsdrm_first_frame_finish();
+        ret = KMSDRM_drmModeSetCrtc(viddata->drm_fd, dispdata->crtc->crtc_id, fb_info->fb_id, 0, 0,
+                                    &dispdata->connector->connector_id, 1, &dispdata->mode);
+        if (ret) {
+            SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "Could not set videomode on CRTC.");
+            return 0;
+        }
+    } else {
+        ret = KMSDRM_drmModePageFlip(viddata->drm_fd, dispdata->crtc->crtc_id, fb_info->fb_id,
+                                     DRM_MODE_PAGE_FLIP_EVENT, &windata->waiting_for_flip);
+        if (ret == 0) {
+            windata->waiting_for_flip = SDL_TRUE;
+        } else {
+            SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "Could not queue pageflip: %d", ret);
+        }
+    }
+    return 1;
+}
+
+static int KMSDRM_GLES_SwapPipelined(_THIS, SDL_Window *window)
+{
+    SDL_WindowData *windata = ((SDL_WindowData *)window->driverdata);
+    double t0 = tm_on ? tm_now() : 0, t1, t2;
+    if (pipe_pending && !KMSDRM_GLES_FinishPending(_this, window)) {
+        return 0;
+    }
+    t1 = tm_on ? tm_now() : 0;
+    if (!(_this->egl_data->eglSwapBuffers(_this->egl_data->egl_display, windata->egl_surface))) {
+        SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "eglSwapBuffers failed");
+        return 0;
+    }
+    pipe_pending = SDL_TRUE;
+    if (!KMSDRM_gbm_surface_has_free_buffers || !KMSDRM_gbm_surface_has_free_buffers(windata->gs)) {
+        if (!KMSDRM_GLES_FinishPending(_this, window)) {
+            return 0;
+        }
+        tm_flip += 1; /* counts the frames that could not be pipelined */
+    }
+    t2 = tm_on ? tm_now() : 0;
+    if (tm_on) {
+        tm_lock += t1 - t0; tm_swap += t2 - t1;
+        if (++tm_n == 300) {
+            fprintf(stderr, "kmsdrm pipelined swap: finish-previous %.2f eglSwap %.2f ms, %d of 300 not pipelined\n",
+                    tm_lock / 300, tm_swap / 300, (int)tm_flip);
+            tm_n = 0; tm_wait = tm_swap = tm_lock = tm_flip = 0;
+        }
+    }
+    return 1;
+}
+
+/* ======================================================================================================== */
+/* Partycade: SDL_KMSDRM_BUFFERS=N (2, 3 or 4). The one way pictures reach the screen (2026-11-25).
+
+   Why. The Mali's GBM surface has two buffers. Any overlap of the CPU and GPU through it (the pipelined swap)
+   had the GPU draw the next picture into the one still on the screen: moving pictures tore, found with test
+   patterns on the cabinet (tools/cabview/fliptest.c showed the display itself switches cleanly at the frame
+   boundary). So SDL keeps buffers of its own, and the GPU is never given the one on the screen:
+
+   - N buffers made by the display driver (the Mali refused its own GBM buffers as render targets), imported as
+     GL textures behind framebuffer objects (format RA24, the one this Mali takes; scanned out as XBGR8888, the
+     display's red/blue swap is free). The application draws into partycade_kmsdrm_fbo (LÖVE's patched
+     getDefaultFBO, games/love/patches/love-screen-fbo.patch; tvplay binds it itself), upright, as into a canvas.
+   - A swap fences the frame and queues it to a presenter thread, which waits for the GPU, flips to it (the
+     first: set-CRTC, which may change the pixel format) and, once it has latched, frees the buffer it replaced.
+   - One stencil (8 bits) shared, discarded after each frame (written back it cost 6.7 ms of GPU a frame).
+   - The window surface is dropped before it is ever shown (shown once, the display kept its buffers: 3-6 MB).
+
+   N: 2 costs no more memory than the window surface did; the GPU starts a frame once the other buffer has left
+   the screen, so a frame's GPU work must fit a refresh (Home, TV). 3 and 4 let the GPU run on into a free buffer
+   while the last one waits for its frame: full speed, 3 MB a buffer plus ~3 MB of the Mali's (the games, which
+   run alone). Measured on the cabinet: SYSTEM_AUDIT.md K7. Any set-up step refused: the usual swap. */
+#define PC_MAX 4
+enum { PC_FREE, PC_RENDER, PC_QUEUED, PC_SHOWN };
+typedef void *PcSync;
+typedef struct { uint32_t handle, pitch, fb; unsigned int tex, fbo; void *img; int state; PcSync fence; Uint64 queued; } PcBuf;
+/* SDL_KMSDRM_TIMING=1: every 300 frames, how long after the swap the GPU finished a frame (with 3-4 buffers the
+   GPU seldom waits for one, so this is close to its time a frame: the profiler for what a frame costs) */
+static int pc_timing = -1, pc_tn;
+static double pc_tsum, pc_tmax;
+static PcBuf pc_b[PC_MAX];
+static int pc_n = -1, pc_ready, pc_cur, pc_q[PC_MAX], pc_qn, pc_busy, pc_flip_done, pc_crtc_set;
+static SDL_mutex *pc_mu;
+static SDL_cond *pc_cv;
+static void *pc_dpy;
+static int pc_drm_fd;
+static uint32_t pc_crtc, pc_conn;
+static drmModeModeInfo pc_mode;
+__attribute__((visibility("default"))) unsigned int partycade_kmsdrm_fbo;
+
+static void *(*pc_eglCreateImageKHR)(void *, void *, unsigned int, void *, const int *);
+static PcSync (*pc_eglCreateSyncKHR)(void *, unsigned int, const int *);
+static int (*pc_eglClientWaitSyncKHR)(void *, PcSync, int, unsigned long long);
+static unsigned int (*pc_eglDestroySyncKHR)(void *, PcSync);
+static void (*pc_glGenFramebuffers)(int, unsigned int *);
+static void (*pc_glBindFramebuffer)(unsigned int, unsigned int);
+static void (*pc_glFramebufferTexture2D)(unsigned int, unsigned int, unsigned int, unsigned int, int);
+static void (*pc_glGenRenderbuffers)(int, unsigned int *);
+static void (*pc_glBindRenderbuffer)(unsigned int, unsigned int);
+static void (*pc_glRenderbufferStorage)(unsigned int, unsigned int, int, int);
+static void (*pc_glFramebufferRenderbuffer)(unsigned int, unsigned int, unsigned int, unsigned int);
+static unsigned int (*pc_glCheckFramebufferStatus)(unsigned int);
+static void (*pc_glGenTextures)(int, unsigned int *);
+static void (*pc_glBindTexture)(unsigned int, unsigned int);
+static void (*pc_glTexParameteri)(unsigned int, unsigned int, int);
+static void (*pc_glEGLImageTargetTexture2DOES)(unsigned int, void *);
+static void (*pc_glFlush)(void);
+static void (*pc_glDiscardFramebufferEXT)(unsigned int, int, const unsigned int *);
+
+#define PC_GL_TEXTURE_2D 0x0DE1
+#define PC_GL_FRAMEBUFFER 0x8D40
+#define PC_GL_RENDERBUFFER 0x8D41
+#define PC_GL_COLOR_ATTACHMENT0 0x8CE0
+#define PC_GL_STENCIL_ATTACHMENT 0x8D20
+#define PC_GL_STENCIL_INDEX8 0x8D48
+#define PC_GL_FRAMEBUFFER_COMPLETE 0x8CD5
+#define PC_EGL_NONE 0x3038
+
+static void pc_flip_handler(int fd, unsigned int frame, unsigned int sec, unsigned int usec, void *data)
+{
+    (void)fd; (void)frame; (void)sec; (void)usec; (void)data;
+    pc_flip_done = 1;
+}
+
+static void pc_wait_flip(void)
+{
+    drmEventContext ev = { 0 };
+    ev.version = DRM_EVENT_CONTEXT_VERSION;
+    ev.page_flip_handler = pc_flip_handler;
+    while (!pc_flip_done) {
+        struct pollfd pfd = { 0 };
+        pfd.fd = pc_drm_fd;
+        pfd.events = POLLIN;
+        if (poll(&pfd, 1, 100) > 0) KMSDRM_drmHandleEvent(pc_drm_fd, &ev);
+    }
+}
+
+/* The presenter: each queued buffer, once the GPU is done with it, onto the screen at the next frame start. */
+static int pc_present(void *arg)
+{
+    (void)arg;
+    for (;;) {
+        int i, j;
+        SDL_LockMutex(pc_mu);
+        while (pc_qn == 0) SDL_CondWait(pc_cv, pc_mu);
+        i = pc_q[0];
+        SDL_memmove(pc_q, pc_q + 1, (--pc_qn) * sizeof pc_q[0]);
+        pc_busy = 1;
+        SDL_UnlockMutex(pc_mu);
+        if (pc_b[i].fence) {
+            pc_eglClientWaitSyncKHR(pc_dpy, pc_b[i].fence, 0, 0xFFFFFFFFFFFFFFFFull);
+            if (pc_timing) {
+                double ms = (double)(SDL_GetPerformanceCounter() - pc_b[i].queued) * 1000.0 / (double)SDL_GetPerformanceFrequency();
+                pc_tsum += ms;
+                if (ms > pc_tmax) pc_tmax = ms;
+                if (++pc_tn == 300) {
+                    fprintf(stderr, "kmsdrm buffers: GPU done %.1f ms after the swap (max %.0f)\n", pc_tsum / 300, pc_tmax);
+                    pc_tn = 0; pc_tsum = pc_tmax = 0;
+                }
+            }
+            pc_eglDestroySyncKHR(pc_dpy, pc_b[i].fence);
+            pc_b[i].fence = NULL;
+        }
+        pc_flip_done = 0;
+        if (!pc_crtc_set) {
+            pc_crtc_set = 1;
+            if (KMSDRM_drmModeSetCrtc(pc_drm_fd, pc_crtc, pc_b[i].fb, 0, 0, &pc_conn, 1, &pc_mode))
+                SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "buffers: set CRTC failed");
+        } else if (KMSDRM_drmModePageFlip(pc_drm_fd, pc_crtc, pc_b[i].fb, DRM_MODE_PAGE_FLIP_EVENT, NULL) == 0) {
+            pc_wait_flip();
+        } else {
+            /* (busy: once more after a moment; else, typically SDL restoring the screen at the end: only noted) */
+            SDL_Delay(4);
+            if (KMSDRM_drmModePageFlip(pc_drm_fd, pc_crtc, pc_b[i].fb, DRM_MODE_PAGE_FLIP_EVENT, NULL) == 0) pc_wait_flip();
+            else SDL_LogDebug(SDL_LOG_CATEGORY_VIDEO, "buffers: flip failed (%d)", errno);
+        }
+        SDL_LockMutex(pc_mu);
+        for (j = 0; j < pc_n; j++) if (pc_b[j].state == PC_SHOWN) pc_b[j].state = PC_FREE;
+        pc_b[i].state = PC_SHOWN;
+        pc_busy = 0;
+        SDL_CondBroadcast(pc_cv);
+        SDL_UnlockMutex(pc_mu);
+    }
+    return 0;
+}
+
+#define PC_PROC(var, name) do { *(void **)&var = SDL_GL_GetProcAddress(name); if (!var) { \
+        SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "buffers: no %s", name); return 0; } } while (0)
+
+static int pc_setup(_THIS, SDL_Window *window)
+{
+    SDL_VideoData *viddata = ((SDL_VideoData *)_this->driverdata);
+    SDL_DisplayData *dispdata = (SDL_DisplayData *)SDL_GetDisplayForWindow(window)->driverdata;
+    int w = dispdata->mode.hdisplay, h = dispdata->mode.vdisplay, i;
+    unsigned int stencil;
+    PC_PROC(pc_eglCreateImageKHR, "eglCreateImageKHR");
+    PC_PROC(pc_eglCreateSyncKHR, "eglCreateSyncKHR");
+    PC_PROC(pc_eglClientWaitSyncKHR, "eglClientWaitSyncKHR");
+    PC_PROC(pc_eglDestroySyncKHR, "eglDestroySyncKHR");
+    PC_PROC(pc_glGenFramebuffers, "glGenFramebuffers");
+    PC_PROC(pc_glBindFramebuffer, "glBindFramebuffer");
+    PC_PROC(pc_glFramebufferTexture2D, "glFramebufferTexture2D");
+    PC_PROC(pc_glGenRenderbuffers, "glGenRenderbuffers");
+    PC_PROC(pc_glBindRenderbuffer, "glBindRenderbuffer");
+    PC_PROC(pc_glRenderbufferStorage, "glRenderbufferStorage");
+    PC_PROC(pc_glFramebufferRenderbuffer, "glFramebufferRenderbuffer");
+    PC_PROC(pc_glCheckFramebufferStatus, "glCheckFramebufferStatus");
+    PC_PROC(pc_glGenTextures, "glGenTextures");
+    PC_PROC(pc_glBindTexture, "glBindTexture");
+    PC_PROC(pc_glTexParameteri, "glTexParameteri");
+    PC_PROC(pc_glEGLImageTargetTexture2DOES, "glEGLImageTargetTexture2DOES");
+    PC_PROC(pc_glFlush, "glFlush");
+    *(void **)&pc_glDiscardFramebufferEXT = SDL_GL_GetProcAddress("glDiscardFramebufferEXT");
+    pc_dpy = _this->egl_data->egl_display;
+    pc_timing = SDL_getenv("SDL_KMSDRM_TIMING") != NULL;
+    pc_drm_fd = viddata->drm_fd;
+    pc_crtc = dispdata->crtc->crtc_id;
+    pc_conn = dispdata->connector->connector_id;
+    pc_mode = dispdata->mode;
+    pc_glGenRenderbuffers(1, &stencil);
+    pc_glBindRenderbuffer(PC_GL_RENDERBUFFER, stencil);
+    pc_glRenderbufferStorage(PC_GL_RENDERBUFFER, PC_GL_STENCIL_INDEX8, w, h);
+    for (i = 0; i < pc_n; i++) {
+        PcBuf *b = &pc_b[i];
+        struct drm_mode_create_dumb cd;
+        uint32_t handles[4] = {0}, pitches[4] = {0}, offsets[4] = {0};
+        int fd = -1, attr[13];
+        SDL_zero(cd);
+        cd.width = w; cd.height = h; cd.bpp = 32;
+        if (ioctl(pc_drm_fd, DRM_IOCTL_MODE_CREATE_DUMB, &cd)) { SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "buffers: no dumb buffer"); return 0; }
+        b->handle = cd.handle;
+        b->pitch = cd.pitch;
+        handles[0] = cd.handle; pitches[0] = cd.pitch;
+        if (!KMSDRM_drmModeAddFB2 ||
+            KMSDRM_drmModeAddFB2(pc_drm_fd, w, h, 0x34324258 /* XB24 */, handles, pitches, offsets, &b->fb, 0)) {
+            SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "buffers: no framebuffer");
+            return 0;
+        }
+        if (KMSDRM_drmPrimeHandleToFD(pc_drm_fd, b->handle, DRM_CLOEXEC | O_RDWR, &fd) || fd < 0) {
+            SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "buffers: no dma-buf");
+            return 0;
+        }
+        attr[0] = 0x3057 /* EGL_WIDTH */; attr[1] = w; attr[2] = 0x3056 /* EGL_HEIGHT */; attr[3] = h;
+        attr[4] = 0x3271 /* EGL_LINUX_DRM_FOURCC_EXT */; attr[5] = 0x34324152 /* RA24 */;
+        attr[6] = 0x3272 /* EGL_DMA_BUF_PLANE0_FD_EXT */; attr[7] = fd;
+        attr[8] = 0x3273 /* EGL_DMA_BUF_PLANE0_OFFSET_EXT */; attr[9] = 0;
+        attr[10] = 0x3274 /* EGL_DMA_BUF_PLANE0_PITCH_EXT */; attr[11] = (int)b->pitch;
+        attr[12] = PC_EGL_NONE;
+        b->img = pc_eglCreateImageKHR(pc_dpy, NULL, 0x3270 /* EGL_LINUX_DMA_BUF_EXT */, NULL, attr);
+        close(fd);
+        if (!b->img) { SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "buffers: no EGLImage (0x%x)", _this->egl_data->eglGetError()); return 0; }
+        pc_glGenTextures(1, &b->tex);
+        pc_glBindTexture(PC_GL_TEXTURE_2D, b->tex);
+        pc_glTexParameteri(PC_GL_TEXTURE_2D, 0x2801 /* MIN_FILTER */, 0x2600 /* NEAREST */);
+        pc_glTexParameteri(PC_GL_TEXTURE_2D, 0x2800 /* MAG_FILTER */, 0x2600);
+        pc_glEGLImageTargetTexture2DOES(PC_GL_TEXTURE_2D, b->img);
+        pc_glGenFramebuffers(1, &b->fbo);
+        pc_glBindFramebuffer(PC_GL_FRAMEBUFFER, b->fbo);
+        pc_glFramebufferTexture2D(PC_GL_FRAMEBUFFER, PC_GL_COLOR_ATTACHMENT0, PC_GL_TEXTURE_2D, b->tex, 0);
+        pc_glFramebufferRenderbuffer(PC_GL_FRAMEBUFFER, PC_GL_STENCIL_ATTACHMENT, PC_GL_RENDERBUFFER, stencil);
+        if (pc_glCheckFramebufferStatus(PC_GL_FRAMEBUFFER) != PC_GL_FRAMEBUFFER_COMPLETE) {
+            SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "buffers: framebuffer incomplete");
+            return 0;
+        }
+        b->state = PC_FREE;
+    }
+    pc_glBindTexture(PC_GL_TEXTURE_2D, 0);
+    pc_mu = SDL_CreateMutex();
+    pc_cv = SDL_CreateCond();
+    SDL_CreateThreadInternal(pc_present, "kmsdrm-present", 0, NULL);
+    pc_cur = 0;
+    pc_b[0].state = PC_RENDER;
+    partycade_kmsdrm_fbo = pc_b[0].fbo;
+    pc_glBindFramebuffer(PC_GL_FRAMEBUFFER, pc_b[0].fbo);
+    return 1;
+}
+
+/* The window surface's buffers are never used now: the context moves to a 16 x 16 pbuffer and the window surface
+   and its GBM surface go, before any of their buffers is locked or put on the screen. (Refused: all kept.) */
+static void pc_drop_window(_THIS, SDL_Window *window)
+{
+    SDL_WindowData *windata = (SDL_WindowData *)window->driverdata;
+    static const int pa[] = {0x3057, 16, 0x3056, 16, PC_EGL_NONE};
+    void *ctx = SDL_GL_GetCurrentContext();
+    EGLSurface pb;
+    if (!ctx || !_this->egl_data->eglCreatePbufferSurface) return;
+    pb = _this->egl_data->eglCreatePbufferSurface(_this->egl_data->egl_display, _this->egl_data->egl_config, pa);
+    if (pb == EGL_NO_SURFACE) return;
+    if (!_this->egl_data->eglMakeCurrent(_this->egl_data->egl_display, pb, pb, (EGLContext)ctx)) {
+        _this->egl_data->eglDestroySurface(_this->egl_data->egl_display, pb);
+        return;
+    }
+    if (windata->bo) KMSDRM_gbm_surface_release_buffer(windata->gs, windata->bo);
+    if (windata->next_bo) KMSDRM_gbm_surface_release_buffer(windata->gs, windata->next_bo);
+    windata->bo = windata->next_bo = NULL;
+    _this->egl_data->eglDestroySurface(_this->egl_data->egl_display, windata->egl_surface);
+    windata->egl_surface = pb;
+    if (windata->gs) { KMSDRM_gbm_surface_destroy(windata->gs); windata->gs = NULL; }
+    pc_glBindFramebuffer(PC_GL_FRAMEBUFFER, pc_b[pc_cur].fbo);
+}
+
+static int pc_swap(void)
+{
+    int i, next = -1;
+    if (pc_glDiscardFramebufferEXT) {
+        static const unsigned int st[1] = {PC_GL_STENCIL_ATTACHMENT};
+        pc_glDiscardFramebufferEXT(PC_GL_FRAMEBUFFER, 1, st);
+    }
+    SDL_LockMutex(pc_mu);
+    /* (two buffers: this frame's buffer was the one on the screen when it was given; its drawing goes to the GPU
+       only once the other has replaced it there) */
+    if (pc_n == 2) while (pc_qn > 0 || pc_busy) SDL_CondWait(pc_cv, pc_mu);
+    SDL_UnlockMutex(pc_mu);
+    pc_b[pc_cur].fence = pc_eglCreateSyncKHR(pc_dpy, 0x30F9 /* EGL_SYNC_FENCE_KHR */, NULL);
+    pc_b[pc_cur].queued = SDL_GetPerformanceCounter();
+    pc_glFlush();
+    SDL_LockMutex(pc_mu);
+    pc_b[pc_cur].state = PC_QUEUED;
+    pc_q[pc_qn++] = pc_cur;
+    SDL_CondBroadcast(pc_cv);
+    for (;;) {
+        for (i = 0; i < pc_n; i++) if (pc_b[i].state == PC_FREE) { next = i; break; }
+        /* (two buffers: the other one, still on the screen; drawn into only after the wait above, next swap) */
+        if (next < 0 && pc_n == 2) for (i = 0; i < pc_n; i++) if (i != pc_cur && pc_b[i].state == PC_SHOWN) { next = i; break; }
+        if (next >= 0) break;
+        SDL_CondWait(pc_cv, pc_mu);
+    }
+    pc_b[next].state = PC_RENDER;
+    SDL_UnlockMutex(pc_mu);
+    pc_cur = next;
+    partycade_kmsdrm_fbo = pc_b[next].fbo;
+    pc_glBindFramebuffer(PC_GL_FRAMEBUFFER, pc_b[next].fbo);
+    return 1;
+}
+/* ======================================================================================================== */
