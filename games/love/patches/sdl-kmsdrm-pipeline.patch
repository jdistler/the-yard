+    tri_b[tri_cur].state = TRI_QUEUED;
+    tri_q[tri_qn++] = tri_cur;
+    SDL_CondBroadcast(tri_cv);
+    for (;;) {
+        for (i = 0; i < TRI_N; i++) if (tri_b[i].state == TRI_FREE) { next = i; break; }
+        if (next >= 0) break;
