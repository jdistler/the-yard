+        SDL_CondWait(tri_cv, tri_mu);
+    }
+    tri_b[next].state = TRI_RENDER;
+    SDL_UnlockMutex(tri_mu);
+    tri_cur = next;
+    partycade_kmsdrm_fbo = tri_b[next].fbo;
+    tri_glBindFramebuffer(TRI_GL_FRAMEBUFFER, tri_b[next].fbo);
+    if (!tri_reclaimed && tri_crtc_set && tri_frames > 2 && !SDL_getenv("SDL_KMSDRM_TRIPLE_KEEP")) tri_reclaim(_this, window);
