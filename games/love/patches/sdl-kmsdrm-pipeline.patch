+/* Partycade: SDL_KMSDRM_TIMING=1 prints, every 300 swaps, the mean time of each step below (ms). */
+static int tm_on = -1, tm_n;
+static double tm_wait, tm_swap, tm_lock, tm_flip;
+static double tm_now(void) { return (double)SDL_GetPerformanceCounter() * 1000.0 / (double)SDL_GetPerformanceFrequency(); }
+
+/* Partycade: SDL_KMSDRM_SAFE=1. The Mali draws into whichever of the surface's buffers it is given, and on this
+   board (2 buffers, no fence wait in Rockchip's commit: "TODO: do fence wait here") that could be the one still on
+   the screen: work the GPU did before the old picture left the screen (a canvas switch, a texture upload, a
+   finish, or LÖVE's pipelined swap) was drawn into the picture being shown, and moving pictures tore (the TV,
+   2026-11-25: a dumb-buffer test showed the display itself switches cleanly at the frame boundary). Here each
+   swap waits for its flip to complete and gives the old buffer back at once: the only buffer the GPU can be
+   given is one the screen no longer shows. */
+static int safe_on = -1;
+
+/* Partycade: SDL_KMSDRM_PIPELINE=1. On the Mali-400, gbm_surface_lock_front_buffer waits for the GPU to finish
+   the frame (10-18 ms), so the CPU idled while the GPU drew. Here a frame is handed to EGL and only locked and
+   flipped at the next swap, so the CPU builds frame N+1 while the GPU draws N. If the surface has no free buffer
+   left for the next frame, the frame is finished at once, as before. */
+static int pipe_on = -1;
+static SDL_bool pipe_pending;
+
+/* Partycade: the first frame goes on the screen with drmModeSetCrtc, and on the Mali the buffer could still be
+   unfinished then: the screen showed black for one frame before the first picture (filmed with tools/cabview,
+   2026-10-27), a blink between the picture in /dev/fb0 and the program. Wait for the GPU, before that first
+   drmModeSetCrtc only (both swap paths). */
+static void kmsdrm_first_frame_finish(void)
+{
+    static void (*gl_finish)(void);
+    if (!gl_finish) {
+        gl_finish = (void (*)(void))SDL_GL_GetProcAddress("glFinish");
+    }
+    if (gl_finish) {
+        double a = tm_now();
+        gl_finish();
+        if (SDL_getenv("SDL_KMSDRM_DEBUG")) fprintf(stderr, "kmsdrm: first frame, glFinish waited %.2f ms\n", tm_now() - a);
+    } else if (SDL_getenv("SDL_KMSDRM_DEBUG")) {
+        fprintf(stderr, "kmsdrm: first frame, no glFinish\n");
+    }
+}
+
+/* Partycade: SDL_KMSDRM_COUNT=1 logs how many distinct buffers the GBM surface hands out (every 300 locks). */
+static void count_bo(struct gbm_bo *bo)
+{
+    static int on = -1, n, seen_n, locks;
+    static struct gbm_bo *seen[16];
+    if (on < 0) on = SDL_getenv("SDL_KMSDRM_COUNT") != NULL;
+    if (!on || !bo) return;
+    for (n = 0; n < seen_n && seen[n] != bo; n++) {}
+    if (n == seen_n && seen_n < 16) seen[seen_n++] = bo;
+    if (++locks % 300 == 0) fprintf(stderr, "kmsdrm: %d distinct buffers in %d locks\n", seen_n, locks);
+}
+
+static int KMSDRM_GLES_FinishPending(_THIS, SDL_Window *window)
+{
+    SDL_WindowData *windata = ((SDL_WindowData *)window->driverdata);
+    SDL_DisplayData *dispdata = (SDL_DisplayData *)SDL_GetDisplayForWindow(window)->driverdata;
+    SDL_VideoData *viddata = ((SDL_VideoData *)_this->driverdata);
+    KMSDRM_FBInfo *fb_info;
+    struct gbm_bo *bo;
+    int ret;
+    pipe_pending = SDL_FALSE;
+    bo = KMSDRM_gbm_surface_lock_front_buffer(windata->gs);
+    if (!bo) {
+        SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "Could not lock front buffer on GBM surface");
+        return 0;
+    }
+    count_bo(bo);
+    fb_info = KMSDRM_FBFromBO(_this, bo);
+    if (!fb_info) {
+        return 0;
+    }
+    /* Partycade: SDL_KMSDRM_PIPELINE=4. The frame on the screen with a blocking set-CRTC: the driver writes the
+       display's registers in the call (a page flip goes through a deferred worker, which often missed the frame
+       start and cost a refresh: mode 3 ran Home at 36 fps) and returns once the frame has latched. Then the picture
+       it replaced is given back and is the only one the GPU can be given: no tearing, no extra memory (the Mali's
+       own two buffers). */
+    if (pipe_on == 4 && windata->crtc_ready) {
+        if (KMSDRM_drmModeSetCrtc(viddata->drm_fd, dispdata->crtc->crtc_id, fb_info->fb_id, 0, 0,
+                                  &dispdata->connector->connector_id, 1, &dispdata->mode)) {
+            SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "Could not set the CRTC");
+        }
+        if (windata->bo) KMSDRM_gbm_surface_release_buffer(windata->gs, windata->bo);
+        if (windata->next_bo) KMSDRM_gbm_surface_release_buffer(windata->gs, windata->next_bo);
+        windata->bo = NULL;
+        windata->next_bo = bo;
+        return 1;
+    }
+    if (!KMSDRM_WaitPageflip(_this, windata)) {
+        return 0;
+    }
+    if (windata->bo) {
+        KMSDRM_gbm_surface_release_buffer(windata->gs, windata->bo);
+    }
+    windata->bo = windata->next_bo;
+    windata->next_bo = bo;
+    if (!windata->bo && !windata->crtc_ready) {
+        kmsdrm_first_frame_finish();
+        ret = KMSDRM_drmModeSetCrtc(viddata->drm_fd, dispdata->crtc->crtc_id, fb_info->fb_id, 0, 0,
+                                    &dispdata->connector->connector_id, 1, &dispdata->mode);
+        if (ret) {
+            SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "Could not set videomode on CRTC.");
+            return 0;
+        }
+        windata->crtc_ready = SDL_TRUE;
+    } else {
+        ret = KMSDRM_drmModePageFlip(viddata->drm_fd, dispdata->crtc->crtc_id, fb_info->fb_id,
+                                     DRM_MODE_PAGE_FLIP_EVENT, &windata->waiting_for_flip);
+        if (ret == 0) {
+            windata->waiting_for_flip = SDL_TRUE;
+        } else {
+            SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "Could not queue pageflip: %d", ret);
+        }
+    }
+    return 1;
+}
+
+static int KMSDRM_GLES_SwapPipelined(_THIS, SDL_Window *window)
+{
+    SDL_WindowData *windata = ((SDL_WindowData *)window->driverdata);
+    double t0 = tm_on ? tm_now() : 0, t1, t2;
+    if (pipe_pending && !KMSDRM_GLES_FinishPending(_this, window)) {
+        return 0;
+    }
+    /* Partycade: SDL_KMSDRM_PIPELINE=2. The flip just issued is waited for (it latches at the next frame start)
+       before this frame goes to the GPU, and the picture it replaced is given back then: the GPU draws only into a
+       buffer the screen no longer shows (with 1 the Mali drew into the shown picture and motion tore, 2026-11-25),
+       while the CPU still builds the next frame as the GPU draws this one. */
+    if (pipe_on >= 2 && windata->waiting_for_flip) {
+        if (!KMSDRM_WaitPageflip(_this, windata)) {
+            return 0;
+        }
+        if (windata->bo) {
+            KMSDRM_gbm_surface_release_buffer(windata->gs, windata->bo);
+            windata->bo = NULL;
+        }
+    }
+    t1 = tm_on ? tm_now() : 0;
+    if (!(_this->egl_data->eglSwapBuffers(_this->egl_data->egl_display, windata->egl_surface))) {
+        SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "eglSwapBuffers failed");
+        return 0;
+    }
+    pipe_pending = SDL_TRUE;
+    /* (=3: as 2, without this check: the Mali's surface has two buffers, so after the swap it never has a free one,
+       and 2 fell back to finishing every frame at once: 34 fps for Home) */
+    if (pipe_on < 3 && (!KMSDRM_gbm_surface_has_free_buffers || !KMSDRM_gbm_surface_has_free_buffers(windata->gs))) {
+        if (!KMSDRM_GLES_FinishPending(_this, window)) {
+            return 0;
+        }
+        tm_flip += 1; /* counts the frames that could not be pipelined */
+    }
+    t2 = tm_on ? tm_now() : 0;
+    if (tm_on) {
+        tm_lock += t1 - t0; tm_swap += t2 - t1;
+        if (++tm_n == 300) {
+            fprintf(stderr, "kmsdrm pipelined swap: finish-previous %.2f eglSwap %.2f ms, %d of 300 not pipelined\n",
+                    tm_lock / 300, tm_swap / 300, (int)tm_flip);
+            tm_n = 0; tm_wait = tm_swap = tm_lock = tm_flip = 0;
+        }
+    }
+    return 1;
+}
+
+/* Partycade: SDL_KMSDRM_TRIPLE=1. Three scanout buffers of SDL's own, drawn into directly (no copy), so the CPU
+   and the GPU overlap (Home at ~58 fps needs it) and the GPU is never given the picture on the screen.
+   The Mali's GBM surface has two buffers (counted, 2026-11-25): overlapping with two meant drawing into the shown
+   one (the tearing), and not overlapping halved Home (29-36 fps). Each buffer is a GBM bo the display can scan
+   out, imported into GL as an EGLImage texture behind a framebuffer object; the application draws into
+   partycade_kmsdrm_fbo (LÖVE's patched getDefaultFBO; LÖVE draws it upright as it draws a canvas). At a swap
+   the finished buffer gets a fence and goes to a presenter thread, which waits for the GPU, flips to it and,
+   when the flip has latched, frees the buffer it replaced. The application draws on into the third. */
+#define TRI_MAX 4
+static int tri_n = 4;       /* SDL_KMSDRM_TRIPLE=N: N buffers (3 or 4; 1 or other values: 4) */
+#define TRI_N (tri_n)
+enum { TRI_FREE, TRI_RENDER, TRI_QUEUED, TRI_SHOWN };
+typedef void *TriEGLSync;
+typedef struct { uint32_t handle, pitch, fb; unsigned int tex, fbo; void *img; int state; TriEGLSync fence; double queued; } TriBuf;
+static double tri_gpu_sum, tri_gpu_max, tri_lat_sum;
+static int tri_gpu_n;
+static TriBuf tri_b[TRI_MAX];
+static int tri_on = -1, tri_ready, tri_cur, tri_q[TRI_MAX], tri_qn, tri_flip_done;
+static SDL_mutex *tri_mu;
+static SDL_cond *tri_cv;
+static SDL_Thread *tri_thread;
+static void *tri_dpy;
+static int tri_drm_fd;
+static uint32_t tri_crtc, tri_conn;
+static drmModeModeInfo tri_mode;
+static int tri_crtc_set;
+static long tri_frames, tri_waits;
+__attribute__((visibility("default"))) unsigned int partycade_kmsdrm_fbo;
+
+#define TRI_EGL_LINUX_DMA_BUF_EXT 0x3270
+#define TRI_EGL_WIDTH 0x3057
+#define TRI_EGL_HEIGHT 0x3056
+#define TRI_EGL_LINUX_DRM_FOURCC_EXT 0x3271
+#define TRI_EGL_DMA_BUF_PLANE0_FD_EXT 0x3272
+#define TRI_EGL_DMA_BUF_PLANE0_OFFSET_EXT 0x3273
+#define TRI_EGL_DMA_BUF_PLANE0_PITCH_EXT 0x3274
+#define TRI_EGL_NONE 0x3038
+#define TRI_EGL_SYNC_FENCE_KHR 0x30F9
+#define TRI_EGL_FOREVER_KHR 0xFFFFFFFFFFFFFFFFull
+#define TRI_GL_TEXTURE_2D 0x0DE1
+#define TRI_GL_FRAMEBUFFER 0x8D40
+#define TRI_GL_RENDERBUFFER 0x8D41
+#define TRI_GL_COLOR_ATTACHMENT0 0x8CE0
+#define TRI_GL_DEPTH_ATTACHMENT 0x8D00
+#define TRI_GL_STENCIL_ATTACHMENT 0x8D20
+#define TRI_GL_DEPTH24_STENCIL8_OES 0x88F0
+#define TRI_GL_FRAMEBUFFER_COMPLETE 0x8CD5
+#define TRI_GL_TEXTURE_MIN_FILTER 0x2801
+#define TRI_GL_TEXTURE_MAG_FILTER 0x2800
+#define TRI_GL_NEAREST 0x2600
+#define TRI_DRM_FORMAT_XRGB8888 0x34325258
+
+static void *(*tri_eglCreateImageKHR)(void *, void *, unsigned int, void *, const int *);
+static TriEGLSync (*tri_eglCreateSyncKHR)(void *, unsigned int, const int *);
+static int (*tri_eglClientWaitSyncKHR)(void *, TriEGLSync, int, unsigned long long);
+static unsigned int (*tri_eglDestroySyncKHR)(void *, TriEGLSync);
+static void (*tri_glGenFramebuffers)(int, unsigned int *);
+static void (*tri_glBindFramebuffer)(unsigned int, unsigned int);
+static void (*tri_glFramebufferTexture2D)(unsigned int, unsigned int, unsigned int, unsigned int, int);
+static void (*tri_glGenRenderbuffers)(int, unsigned int *);
+static void (*tri_glBindRenderbuffer)(unsigned int, unsigned int);
+static void (*tri_glRenderbufferStorage)(unsigned int, unsigned int, int, int);
+static void (*tri_glFramebufferRenderbuffer)(unsigned int, unsigned int, unsigned int, unsigned int);
+static unsigned int (*tri_glCheckFramebufferStatus)(unsigned int);
+static void (*tri_glGenTextures)(int, unsigned int *);
+static void (*tri_glBindTexture)(unsigned int, unsigned int);
+static void (*tri_glTexParameteri)(unsigned int, unsigned int, int);
+static void (*tri_glEGLImageTargetTexture2DOES)(unsigned int, void *);
+static void (*tri_glFlush)(void);
+static void (*tri_glDiscardFramebufferEXT)(unsigned int, int, const unsigned int *);
+
+static void tri_flip_handler(int fd, unsigned int frame, unsigned int sec, unsigned int usec, void *data)
+{
+    (void)fd; (void)frame; (void)sec; (void)usec; (void)data;
+    tri_flip_done = 1;
+}
+
+static int tri_present(void *arg)
+{
+    drmEventContext ev = { 0 };
+    (void)arg;
+    ev.version = DRM_EVENT_CONTEXT_VERSION;
+    ev.page_flip_handler = tri_flip_handler;
+    for (;;) {
+        int i, j;
+        SDL_LockMutex(tri_mu);
+        while (tri_qn == 0) SDL_CondWait(tri_cv, tri_mu);
+        i = tri_q[0];
+        SDL_memmove(tri_q, tri_q + 1, (--tri_qn) * sizeof tri_q[0]);
+        SDL_UnlockMutex(tri_mu);
+        /* the GPU done with it */
+        if (tri_b[i].fence) {
+            double tw = tm_now();
+            tri_eglClientWaitSyncKHR(tri_dpy, tri_b[i].fence, 0, TRI_EGL_FOREVER_KHR);
+            {   /* (SDL_KMSDRM_TIMING: how long after the swap the GPU finished the frame, every 300) */
+                double done = tm_now(), lat = done - tri_b[i].queued;
+                tri_lat_sum += lat;
+                tri_gpu_sum += done - tw;
+                if (lat > tri_gpu_max) tri_gpu_max = lat;
+                if (++tri_gpu_n == 300) {
+                    if (SDL_getenv("SDL_KMSDRM_TIMING"))
+                        fprintf(stderr, "kmsdrm triple: GPU done %.1f ms after the swap (max %.0f), presenter waited %.1f\n",
+                                tri_lat_sum / 300, tri_gpu_max, tri_gpu_sum / 300);
+                    tri_gpu_n = 0; tri_lat_sum = tri_gpu_sum = tri_gpu_max = 0;
+                }
+            }
+            tri_eglDestroySyncKHR(tri_dpy, tri_b[i].fence);
+            tri_b[i].fence = NULL;
+        }
+        /* the flip (latched by the display at the next frame start), and its completion */
+        tri_flip_done = 0;
+        if (!tri_crtc_set) {
+            /* (the first: a page flip may not change the pixel format, and the screen shows SDL's first, XRGB,
+               frame; setting the CRTC does, and returns once it is on the screen) */
+            tri_crtc_set = 1;
+            if (KMSDRM_drmModeSetCrtc(tri_drm_fd, tri_crtc, tri_b[i].fb, 0, 0, &tri_conn, 1, &tri_mode))
+                SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "triple: set CRTC failed");
+        } else if (KMSDRM_drmModePageFlip(tri_drm_fd, tri_crtc, tri_b[i].fb, DRM_MODE_PAGE_FLIP_EVENT, NULL) == 0) {
+            while (!tri_flip_done) {
+                struct pollfd pfd = { 0 };
+                pfd.fd = tri_drm_fd;
+                pfd.events = POLLIN;
+                if (poll(&pfd, 1, 100) > 0) KMSDRM_drmHandleEvent(tri_drm_fd, &ev);
+            }
+        } else {
+            /* (busy: once more after a moment; otherwise, typically SDL restoring the screen at the program's end,
+               only noted) */
+            SDL_Delay(4);
+            if (KMSDRM_drmModePageFlip(tri_drm_fd, tri_crtc, tri_b[i].fb, DRM_MODE_PAGE_FLIP_EVENT, NULL) == 0) {
+                while (!tri_flip_done) {
+                    struct pollfd pfd = { 0 };
+                    pfd.fd = tri_drm_fd;
+                    pfd.events = POLLIN;
+                    if (poll(&pfd, 1, 100) > 0) KMSDRM_drmHandleEvent(tri_drm_fd, &ev);
+                }
+            } else {
+                SDL_LogDebug(SDL_LOG_CATEGORY_VIDEO, "triple: flip failed (%d)", errno);
+            }
+        }
+        SDL_LockMutex(tri_mu);
+        for (j = 0; j < TRI_N; j++) if (tri_b[j].state == TRI_SHOWN) tri_b[j].state = TRI_FREE;
+        tri_b[i].state = TRI_SHOWN;
+        SDL_CondBroadcast(tri_cv);
+        SDL_UnlockMutex(tri_mu);
+    }
+    return 0;
+}
+
+#define TRI_PROC(var, name) do { *(void **)&var = SDL_GL_GetProcAddress(name); if (!var) { \
+        SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "triple: no %s", name); return 0; } } while (0)
+
+static int tri_setup(_THIS, SDL_Window *window)
+{
+    SDL_VideoData *viddata = ((SDL_VideoData *)_this->driverdata);
+    SDL_DisplayData *dispdata = (SDL_DisplayData *)SDL_GetDisplayForWindow(window)->driverdata;
+    int w = dispdata->mode.hdisplay, h = dispdata->mode.vdisplay, i;
+    unsigned int depth;
+    TRI_PROC(tri_eglCreateImageKHR, "eglCreateImageKHR");
+    TRI_PROC(tri_eglCreateSyncKHR, "eglCreateSyncKHR");
+    TRI_PROC(tri_eglClientWaitSyncKHR, "eglClientWaitSyncKHR");
+    TRI_PROC(tri_eglDestroySyncKHR, "eglDestroySyncKHR");
+    TRI_PROC(tri_glGenFramebuffers, "glGenFramebuffers");
+    TRI_PROC(tri_glBindFramebuffer, "glBindFramebuffer");
+    TRI_PROC(tri_glFramebufferTexture2D, "glFramebufferTexture2D");
+    TRI_PROC(tri_glGenRenderbuffers, "glGenRenderbuffers");
+    TRI_PROC(tri_glBindRenderbuffer, "glBindRenderbuffer");
+    TRI_PROC(tri_glRenderbufferStorage, "glRenderbufferStorage");
+    TRI_PROC(tri_glFramebufferRenderbuffer, "glFramebufferRenderbuffer");
+    TRI_PROC(tri_glCheckFramebufferStatus, "glCheckFramebufferStatus");
+    TRI_PROC(tri_glGenTextures, "glGenTextures");
+    TRI_PROC(tri_glBindTexture, "glBindTexture");
+    TRI_PROC(tri_glTexParameteri, "glTexParameteri");
+    TRI_PROC(tri_glEGLImageTargetTexture2DOES, "glEGLImageTargetTexture2DOES");
+    TRI_PROC(tri_glFlush, "glFlush");
+    *(void **)&tri_glDiscardFramebufferEXT = SDL_GL_GetProcAddress("glDiscardFramebufferEXT");
+    tri_dpy = _this->egl_data->egl_display;
+    tri_drm_fd = viddata->drm_fd;
+    tri_crtc = dispdata->crtc->crtc_id;
+    tri_conn = dispdata->connector->connector_id;
+    tri_mode = dispdata->mode;
+    /* one stencil for all of them (LÖVE's stencils on the screen: the night's moon, the Yard), 8 bits: nothing on
+       the cabinet draws with depth, and depth + stencil was 3 MB more (memory is what this board runs out of) */
+    tri_glGenRenderbuffers(1, &depth);
+    tri_glBindRenderbuffer(TRI_GL_RENDERBUFFER, depth);
+    tri_glRenderbufferStorage(TRI_GL_RENDERBUFFER, 0x8D48 /* GL_STENCIL_INDEX8 */, w, h);
+    for (i = 0; i < TRI_N; i++) {
+        TriBuf *b = &tri_b[i];
+        int fd = -1, attr[13];
+        /* (display-driver "dumb" buffers: the Mali refused its own GBM buffers as render targets, EGL_BAD_MATCH; it
+           takes the display driver's, as tvplay's decoded video shows) */
+        {
+            struct drm_mode_create_dumb cd;
+            SDL_zero(cd);
+            cd.width = w; cd.height = h; cd.bpp = 32;
+            if (ioctl(viddata->drm_fd, DRM_IOCTL_MODE_CREATE_DUMB, &cd)) {
+                SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "triple: no dumb buffer");
+                return 0;
+            }
+            b->handle = cd.handle;
+            b->pitch = cd.pitch;
+            /* (XBGR8888: the GPU writes R, G, B, A in byte order, which the display reads with its red/blue swap
+               bit, free; as XRGB8888 red and blue came out swapped) */
+            uint32_t handles[4] = {cd.handle}, pitches[4] = {cd.pitch}, offsets[4] = {0};
+            if (!KMSDRM_drmModeAddFB2 ||
+                KMSDRM_drmModeAddFB2(viddata->drm_fd, w, h, 0x34324258 /* XB24 */, handles, pitches, offsets, &b->fb, 0)) {
+                SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "triple: no framebuffer");
+                return 0;
+            }
+        }
+        /* (read-write: a render target is written; a read-only export was refused with EGL_BAD_MATCH) */
+        if (KMSDRM_drmPrimeHandleToFD(viddata->drm_fd, b->handle, DRM_CLOEXEC | O_RDWR, &fd) || fd < 0) {
+            SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "triple: no dma-buf");
+            return 0;
+        }
+        {
+            /* (the same bytes under the names the Mali may take: ARGB first, the display ignores the alpha) */
+            /* (RA24 is the one this Mali takes, 2026-11-25; the rest refused with EGL_BAD_MATCH) */
+            static const int fourccs[] = {0x34324152 /* RA24 */, 0x34324142 /* BA24 */, 0x34325241 /* AR24 */,
+                                          0x34325258 /* XR24 */, 0x34324241 /* AB24 */, 0x34324258 /* XB24 */};
+            unsigned f;
+            b->img = NULL;
+            for (f = 0; f < sizeof fourccs / sizeof fourccs[0] && !b->img; f++) {
+                attr[0] = TRI_EGL_WIDTH; attr[1] = w; attr[2] = TRI_EGL_HEIGHT; attr[3] = h;
+                attr[4] = TRI_EGL_LINUX_DRM_FOURCC_EXT; attr[5] = fourccs[f];
+                attr[6] = TRI_EGL_DMA_BUF_PLANE0_FD_EXT; attr[7] = fd;
+                attr[8] = TRI_EGL_DMA_BUF_PLANE0_OFFSET_EXT; attr[9] = 0;
+                attr[10] = TRI_EGL_DMA_BUF_PLANE0_PITCH_EXT; attr[11] = (int)b->pitch;
+                attr[12] = TRI_EGL_NONE;
+                b->img = tri_eglCreateImageKHR(tri_dpy, NULL, TRI_EGL_LINUX_DMA_BUF_EXT, NULL, attr);
+                if (!b->img) SDL_LogDebug(SDL_LOG_CATEGORY_VIDEO, "triple: EGLImage %08x refused (0x%x)", fourccs[f],
+                                          _this->egl_data->eglGetError());
+            }
+        }
