# Libretro cores for the Partycade's RetroArch 1.7.4: armhf, glibc 2.28, GCC 8 (C++ cores link libstdc++ static).
FROM partycade-armhf:latest
RUN printf 'deb http://archive.debian.org/debian buster main\ndeb http://archive.debian.org/debian-security buster/updates main\n' > /etc/apt/sources.list \
 && apt-get -o Acquire::Check-Valid-Until=false update \
 && apt-get install -y --no-install-recommends g++-arm-linux-gnueabihf git gcc g++ libc6-dev \
 && rm -rf /var/lib/apt/lists/*
