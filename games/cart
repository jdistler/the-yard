    p.add_argument("--out", required=True, help="a new folder under ~/partycade-dumps/")
    p.add_argument("--first", action="store_true", help="install yard, orb and yard.pak as new files")
    p.add_argument("--remove", nargs="*", default=["keep", "lamp", "tea", "chest"],
                   help="with --first: old binaries to take out (default: the C games)")
    p.add_argument("--with-love-probe", action="store_true",
                   help="also stage the LOVE bundle and probe, with a 'LOVE probe' menu row (FIELD_TASKS.md)")
    p.add_argument("--with-sysprobe", action="store_true",
                   help="also stage the read-only system probe, with a 'System probe' menu row (FIELD_TASKS.md)")
    p.add_argument("--start-from", default=None,
                   help="with --first: the GAME_NAME=... text in start.sh to point at yard, if not already")
    a = ap.parse_args()
    {"new": cmd_new, "list": cmd_list, "run": cmd_run, "check": cmd_check, "shots": cmd_shots, "perf": cmd_perf,
     "pack": cmd_pack, "deploy": cmd_deploy, "love-pack": cmd_love_pack, "love": cmd_love}[a.cmd](a)


if __name__ == "__main__":
    main()
