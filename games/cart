#!/usr/bin/env python3
"""cart: make, check, and ship Yard carts. Everything here runs on the PC; nothing touches the cabinet.

  ./cart new ID [--from blank|arcade|story] [--title T] [--large]   start a cart from a template
  ./cart list                                     every cart the runtime can see
  ./cart run ID [--fast]                          play it in a window; edits reload live (YARD_DEV)
  ./cart check [ID ...]                           the gate: lint, a played session, a mashed session,
                                                  pictures to look at, the frame cost (default: all)
  ./cart shots ID [FRAME ...] [--auto]            PNG pictures of chosen frames, in out/shots/ID/
  ./cart perf ID [--frames N]                     instructions per frame (callgrind), against the budget
  ./cart pack [--out FILE]                        build yard.pak: every cart, padded to its fixed slot
  ./cart deploy --raw RAW --out DIR [--first]     stage yard, orb, and yard.pak onto a copy of a raw dump
                [--with-love-probe]               ... plus LÖVE, its probe, and a "GPU yard" row (FIELD_TASKS.md)
                [--with-sysprobe]                 ... plus the read-only "System probe" row (FIELD_TASKS.md)
  ./cart love [ID]                                play on LÖVE, the GPU runtime (games/love/build.sh x86 first)
  ./cart love-pack [--out FILE]                   build yard.love: the LÖVE runtime, library, and font
  ./cart home-pack [--out FILE]                   build home.love: Partycade Home (games/love/home)

A cart is a folder in carts/: info.lua (the label: title, blurb, icon, stat) and main.lua (the game),
plus any other .lua it imports, .png pictures, and .txt data. CARTS.md is the API. GAMEDEV.md the rules.
"""
import argparse
import json
import os
import random
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import zlib

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
CARTS = os.path.join(HERE, "carts")
TEMPLATES = os.path.join(HERE, "templates")
YARD = os.path.join(HERE, "out", "pc", "yard")
ALLOWED = (".lua", ".png", ".txt", ".ttf", ".md")
MAX_FILE = 512 * 1024
# Slots on the cabinet: each file is padded to this size so an update rewrites the blocks it
# already has (data_patch.py --overwrite) instead of asking the disk for new ones.
SLOTS = {"yard": 2 << 20, "orb": 1 << 20, "yard.pak": 4 << 20}
# Frame budget, in PC (x86) instructions per frame measured by callgrind. Tea, the busiest
# cart, runs at about 7.1M; the Cortex-A7 at 1 GHz holds 60 frames a second up to roughly
# 9M by this yardstick (an estimate from the C builds that ran on the cabinet; see STATUS.md).
BUDGET = 9_000_000
GOOD = "\033[32m" if sys.stdout.isatty() else ""
BAD = "\033[31m" if sys.stdout.isatty() else ""
END = "\033[0m" if sys.stdout.isatty() else ""


def die(msg):
    print(f"{BAD}{msg}{END}")
    sys.exit(1)


def build():
    r = subprocess.run(["make", "-s", "TARGET=pc"], cwd=HERE, capture_output=True, text=True)
    if r.returncode:
        die("build failed:\n" + r.stdout + r.stderr)


def carts():
    out = []
    for name in sorted(os.listdir(CARTS)):
        if os.path.isfile(os.path.join(CARTS, name, "info.lua")):
            out.append(name)
    return out


def env(extra=None):
    e = dict(os.environ)
    e.update({"SDL_VIDEODRIVER": "dummy", "SDL_AUDIODRIVER": "dummy", "CAB_SCALE": "1"})
    e.update(extra or {})
    return e


def native(cid):
    text = open(os.path.join(CARTS, cid, "info.lua")).read()
    m = re.search(r'native\s*=\s*"([a-z0-9_-]+)"', text)
    return m.group(1) if m else None


def bmp_to_png(src, dst):
    try:
        from PIL import Image
        Image.open(src).save(dst)
        os.remove(src)
        return dst
    except Exception:
        return src


# ---------------------------------------------------------------------------- new

def cmd_new(a):
    cid = a.id
    if not re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", cid):
        die("an id is lower-case letters, digits, _ or -, starting with a letter, up to 32 long")
    if cid in ("yard", "orb", "probe"):
        die(f"{cid} is taken")
    dst = os.path.join(CARTS, cid)
    if os.path.exists(dst):
        die(f"carts/{cid} already exists")
    src = os.path.join(TEMPLATES, a.template)
    if not os.path.isdir(src):
        die(f"no template {a.template}; there are: {', '.join(sorted(os.listdir(TEMPLATES)))}")
    os.makedirs(dst)
    title = a.title or cid.replace("_", " ").replace("-", " ").title()
    for name in os.listdir(src):
        text = open(os.path.join(src, name)).read()
        text = text.replace("{{ID}}", cid).replace("{{TITLE}}", title).replace("{{SIZE}}", "large" if a.large else "small")
        open(os.path.join(dst, name), "w").write(text)
    print(f"made carts/{cid} from the {a.template} template")
    print(f"  ./cart run {cid}      play it (edits reload while it runs)")
    print(f"  ./cart check {cid}    the gate before anything ships")


# ---------------------------------------------------------------------------- list / run

def cmd_list(a):
    build()
    subprocess.run([YARD, "--list"], cwd=HERE)


def cmd_run(a):
    build()
    e = dict(os.environ)
    e["YARD_DEV"] = "1"
    args = [YARD, a.id] + (["-fast"] if a.fast else [])
    d = tempfile.mkdtemp(prefix="cart-run-")
    print(f"saves go to {d}. Keys: arrows, Z X C (the three buttons), 1+2 held to quit, Esc.")
    subprocess.run(args, cwd=d, env=e)


# ---------------------------------------------------------------------------- check

def lint(cid):
    """Problems that do not need the game to run."""
    problems, d, total = [], os.path.join(CARTS, cid), 0
    if not os.path.isfile(os.path.join(d, "main.lua")) and not native(cid):
        problems.append("no main.lua")
    for dirpath, _, files in os.walk(d):
        for f in files:
            p = os.path.join(dirpath, f)
            rel = os.path.relpath(p, d)
            size = os.path.getsize(p)
            total += size
            if not f.endswith(ALLOWED):
                problems.append(f"{rel}: only {' '.join(ALLOWED)} files ship in a cart")
            if not re.fullmatch(r"[A-Za-z0-9_./-]+", rel):
                problems.append(f"{rel}: file names are letters, digits, _ - . only")
            if size > MAX_FILE:
                problems.append(f"{rel}: {size // 1024} KB; keep files under {MAX_FILE // 1024} KB")
            if f.endswith(".lua"):
                text = open(p, errors="replace").read()
                for n, line in enumerate(text.splitlines(), 1):
                    code = line.split("--")[0]
                    if re.search(r"\b(os|io|debug|package)\.", code) or re.search(r"\b(require|loadstring|dofile)\s*\(", code):
                        problems.append(f"{rel}:{n}: carts cannot reach os, io, debug, package, require: {line.strip()[:60]}")
                    bare = re.sub(r'"(\\.|[^"\\])*"|\'(\\.|[^\'\\])*\'', '""', code)
                    m = re.search(r"//|<<|>>|[^~=<>]~[^=]|\s[&|]\s|\butf8\.|\bmath\.(type|tointeger|ult)\b|\btable\.move\b|\bstring\.(pack|unpack)\b", bare)
                    if m:
                        problems.append(f"{rel}:{n}: '{m.group(0).strip()}' is Lua 5.3+; carts use the Lua both runtimes speak "
                                        f"(5.1 with goto; idiv(a, b) for //): {line.strip()[:60]}")
                    m = re.search(r"\bmath\.atan\s*\([^()]*,|\bmath\.atan2\b|\btable\.unpack\b|\btable\.pack\b|\bmath\.pow\b|"
                                  r"\bmath\.log\s*\([^()]*,|\bloadstring\b|\bsetfenv\b|\bmath\.maxinteger\b", bare)
                    if m:
                        problems.append(f"{rel}:{n}: '{m.group(0).strip()}' differs between Lua 5.1 (LÖVE) and 5.4; use the "
                                        f"library's atan2(y, x), unpack(t), x ^ y, or math.log(x) / math.log(b): {line.strip()[:60]}")
                    if "\t" in line[: len(line) - len(line.lstrip())]:
                        problems.append(f"{rel}:{n}: indent with spaces")
    luajit = shutil.which("luajit") or next((p for p in (os.path.join(HERE, "out", "love-x86", "luajit"),) if os.path.exists(p)), None)
    if luajit:
        # Parse every file the way LuaJIT (LÖVE) will.
        for dirpath, _, files in os.walk(d):
            for f in files:
                if f.endswith(".lua"):
                    # -b compiles to bytecode without running anything.
                    r = subprocess.run([luajit, "-b", os.path.join(dirpath, f), os.devnull],
                                       capture_output=True, text=True)
                    if r.returncode:
                        problems.append(f"{os.path.relpath(os.path.join(dirpath, f), d)}: LuaJIT cannot parse it: "
                                        f"{(r.stderr.strip().splitlines() or ['?'])[0][:120]}")
    if total > 2 * 1024 * 1024:
        problems.append(f"the cart is {total // 1024} KB; keep a cart under 2 MB")
    return problems


def run_check(cid, frames, script=None, extra=None):
    """Run the cart headless through the runtime's --check. Returns (ok, stdout+log)."""
    d = tempfile.mkdtemp(prefix="cart-check-")
    # CAB_MAX_FRAMES also stops a cart the menu launches mid-check (a separate process, not in check mode),
    # which would otherwise run on forever once the script ran out.
    e = env({"YARD_CHECK_FRAMES": str(frames), "CAB_MAX_FRAMES": str(frames + 1)})
    e.update(extra or {})
    if script is not None:
        path = os.path.join(d, "deck.cab")
        open(path, "w").write(script)
        e["CAB_SCRIPT"] = path
    try:
        r = subprocess.run([YARD, "--check", cid], cwd=d, env=e, capture_output=True, text=True, timeout=300)
    except subprocess.TimeoutExpired:
        return False, "timed out (more than 5 minutes for the session)", d
    out = r.stdout + r.stderr
    return r.returncode == 0 and "\nerror:" not in "\n" + r.stdout, out, d


def mash(seed, frames):
    """A small child at the deck: random presses, holds, and releases on every button."""
    rng = random.Random(seed)
    names = ["UP", "DOWN", "LEFT", "RIGHT", "LOW", "TL", "TR"]
    lines, held = [], set()
    f = 0
    while f < frames:
        f += rng.randint(1, 12)
        b = rng.choice(names)
        if b in held:
            lines.append(f"{f} up {b}")
            held.discard(b)
        else:
            lines.append(f"{f} down {b}")
            held.add(b)
    return "\n".join(lines) + "\n"


def shots(cid, frames, autoplay=True, folder=None):
    folder = folder or os.path.join(HERE, "out", "shots", cid)
    shutil.rmtree(folder, ignore_errors=True)
    os.makedirs(folder)
    script = "".join(f"{f} shot {folder}/{cid}-{f}.bmp\n" for f in frames)
    ok, out, _ = run_check(cid, max(frames) + 1, script, {"CAB_AUTOPLAY": "1"} if autoplay else None)
    made = []
    for f in frames:
        p = os.path.join(folder, f"{cid}-{f}.bmp")
        if os.path.exists(p):
            made.append(bmp_to_png(p, p[:-4] + ".png"))
    return ok, out, made


def sheet(paths, dst):
    """One picture of several frames side by side, to look at in one go."""
    try:
        from PIL import Image
    except ImportError:
        return None
    ims = [Image.open(p) for p in paths]
    if not ims:
        return None
    w, h = ims[0].size
    out = Image.new("RGB", (len(ims) * (w + 6) - 6, h), (40, 40, 40))
    for i, im in enumerate(ims):
        out.paste(im, (i * (w + 6), 0))
    out.save(dst)
    return dst


def perf(cid, frames=600):
    """x86 instructions per frame over an autoplayed session, by callgrind. None if no valgrind."""
    if not shutil.which("valgrind"):
        return None
    d = tempfile.mkdtemp(prefix="cart-perf-")
    out = os.path.join(d, "cg.out")
    e = env({"CAB_AUTOPLAY": "1", "YARD_CHECK_FRAMES": str(frames), "CAB_SCRIPT": "/dev/null"})
    subprocess.run(["valgrind", "--tool=callgrind", f"--callgrind-out-file={out}", YARD, "--check", cid], cwd=d,
                   env=e, capture_output=True, timeout=1800)
    try:
        total = int(re.search(r"^summary:\s*(\d+)", open(out).read(), re.M).group(1))
    except (OSError, AttributeError):
        return None
    return total // frames


def verdict(out):
    for line in out.splitlines():
        if line.startswith(("ok:", "error:")):
            return line
    return out.strip().splitlines()[-1] if out.strip() else "no output"


def cmd_check(a):
    build()
    ids = a.ids or [c for c in carts() if not native(c)]
    failed = []
    for cid in ids:
        if not os.path.isdir(os.path.join(CARTS, cid)):
            die(f"no carts/{cid}")
        print(f"== {cid}")
        problems = lint(cid)
        for p in problems:
            print(f"  {BAD}lint{END} {p}")
        if native(cid):
            print("  native program: only the label is checked here")
            if problems:
                failed.append(cid)
            continue
        ok1, out1, _ = run_check(cid, 1800, "", {"CAB_AUTOPLAY": "1"})
        print(f"  {'ok  ' if ok1 else BAD + 'FAIL' + END} played by its bot() for 30 seconds: {verdict(out1)}")
        ok2, out2, _ = run_check(cid, 1800, mash(cid, 1800))
        print(f"  {'ok  ' if ok2 else BAD + 'FAIL' + END} mashed at random for 30 seconds: {verdict(out2)}")
        for ok, out in ((ok1, out1), (ok2, out2)):
            if not ok:
                print("    " + "\n    ".join(out.strip().splitlines()[-12:]))
        ok3, _, pics = shots(cid, [10, 300, 900])
        s = sheet(pics, os.path.join(HERE, "out", "shots", cid, "sheet.png"))
        print(f"  look at {os.path.relpath(s, HERE) if s else 'out/shots/' + cid}")
        cost = None if a.quick else perf(cid)
        if cost is not None:
            flag = cost <= BUDGET
            print(f"  {'ok  ' if flag else BAD + 'SLOW' + END} {cost / 1e6:.1f}M instructions a frame (budget {BUDGET / 1e6:.0f}M)")
        else:
            flag = True
        if problems or not (ok1 and ok2 and flag):
            failed.append(cid)
    print()
    if failed:
        die(f"not ready: {' '.join(failed)}")
    print(f"{GOOD}all carts pass{END}")


def cmd_shots(a):
    build()
    frames = [int(f) for f in a.frames] or [10, 120, 300, 600]
    ok, out, made = shots(a.id, frames, autoplay=a.auto)
    for m in made:
        print(os.path.relpath(m, HERE))
    if not ok:
        print(out)


def cmd_perf(a):
    build()
    cost = perf(a.id, a.frames)
    if cost is None:
        die("needs valgrind (apt install valgrind)")
    print(f"{a.id}: {cost / 1e6:.2f}M x86 instructions a frame; budget {BUDGET / 1e6:.0f}M "
          f"({'ok' if cost <= BUDGET else 'too slow for the cabinet'})")


# ---------------------------------------------------------------------------- pack

def pack_bytes(extra=()):
    """extra: more cart folders to include, by path (cart deploy --with-love-probe adds its label)."""
    entries = []
    folders = [(cid, os.path.join(CARTS, cid)) for cid in carts()] + [(os.path.basename(e), e) for e in extra]
    for cid, folder in folders:
        for dirpath, _, files in sorted(os.walk(folder)):
            for f in sorted(files):
                if not f.endswith(ALLOWED) or f.endswith(".md"):
                    continue
                p = os.path.join(dirpath, f)
                name = cid + "/" + os.path.relpath(p, folder).replace(os.sep, "/")
                entries.append((name, open(p, "rb").read()))
    body = b""
    for name, data in entries:
        n = name.encode()
        body += struct.pack("<H", len(n)) + n + struct.pack("<II", len(data), zlib.crc32(data) & 0xffffffff) + data
    head = b"YARDPAK1" + struct.pack("<II", len(entries), 16 + len(body))
    return head + body, entries


def cmd_pack(a):
    problems = [p for c in carts() for p in lint(c)]
    if problems:
        die("lint first:\n  " + "\n  ".join(problems))
    data, entries = pack_bytes(getattr(a, "extra", ()))
    slot = SLOTS["yard.pak"]
    if len(data) > slot:
        die(f"the carts need {len(data)} bytes; the yard.pak slot is {slot}")
    out = a.out or os.path.join(HERE, "out", "yard.pak")
    os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
    with open(out, "wb") as f:
        f.write(data + b"\0" * (slot - len(data)))
    print(f"{out}: {len(entries)} files, {len(data) // 1024} KB used of the {slot >> 20} MB slot")
    # Read it back through the runtime, exactly as the cabinet will.
    build()
    d = tempfile.mkdtemp(prefix="cart-pak-")
    r = subprocess.run([YARD, "--list"], cwd=d, env=env({"YARD_PAK": os.path.abspath(out), "YARD_CARTS": d}),
                       capture_output=True, text=True)
    print("  the runtime reads: " + ", ".join(l.split()[0] for l in r.stdout.splitlines() if "pak:" in l))
    return out


# ---------------------------------------------------------------------------- LÖVE

LOVE_X86 = os.path.join(HERE, "out", "love-x86", "run.sh")


def zip_files(out, files):
    """A zip (.love) from [(path, name)], the same bytes for the same contents: fixed dates, sorted names.
    The deploy leaves a file on the cabinet alone when it has not changed (data_patch same_on_disk)."""
    import zipfile
    os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
        for path, name in sorted(files, key=lambda x: x[1]):
            zi = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
            zi.external_attr = 0o644 << 16
            zi.compress_type = zipfile.ZIP_DEFLATED
            z.writestr(zi, open(path, "rb").read())
    return out


def love_pack(out=None):
    """games/love/yard + the shared library + the round font -> a .love (a zip LÖVE runs)."""
    out = out or os.path.join(HERE, "out", "yard.love")
    src = os.path.join(HERE, "love", "yard")
    lib = os.path.join(HERE, "engine", "lib")
    files = [(os.path.join(src, f), f) for f in os.listdir(src) if f.endswith(".lua")]
    files += [(os.path.join(lib, f), "lib/" + f) for f in os.listdir(lib) if f.endswith(".lua")]
    files.append((os.path.join(HERE, "engine", "fonts", "Fredoka-SemiBold.ttf"), "fonts/Fredoka-SemiBold.ttf"))
    # the SHOWS section's tiles (tools/show_thumbs.py)
    thumbs = os.path.join(src, "thumbs")
    if os.path.isdir(thumbs):
        files += [(os.path.join(thumbs, f), "thumbs/" + f) for f in sorted(os.listdir(thumbs)) if f.endswith(".png")]
    return zip_files(out, files)


# Partycade Home's card pictures for our games: a frame of each (./cart shots); the classics' logos are cut
# from the stock menu on the cabinet only (tools/home_art.py).
HOME_SHOTS = {"keep": "keep-900.png", "lamp": "lamp-300.png", "tea": "tea-900.png", "chest": "chest-300.png"}


def home_pack(out=None):
    """games/love/home + the round font + a frame of each of our games -> home.love."""
    out = out or os.path.join(HERE, "out", "home.love")
    src = os.path.join(HERE, "love", "home")
    files = [(os.path.join(src, f), f) for f in os.listdir(src) if f.endswith(".lua")]
    files.append((os.path.join(HERE, "engine", "fonts", "Fredoka-SemiBold.ttf"), "fonts/Fredoka-SemiBold.ttf"))
    files.append((os.path.join(HERE, "engine", "fonts", "Pacifico-Starlight.ttf"), "fonts/Pacifico-Starlight.ttf"))
    # the SHOWS section's tiles (tools/show_thumbs.py) are on the SD card (cart push), not in home.love: /data is
    # ~96% full and an install needs room for the new package beside the old one
    for cid, shot in HOME_SHOTS.items():
        p = os.path.join(HERE, "out", "shots", cid, shot)
        if not os.path.exists(p):
            subprocess.check_call([os.path.join(HERE, "cart"), "shots", cid, "--auto"], cwd=HERE,
                                  stdout=subprocess.DEVNULL)
        if os.path.exists(p):
            files.append((p, f"art/{cid}.png"))
    return zip_files(out, files)


def home_picture(kind, out, art):
    """Home renders one of its pictures for /dev/fb0 (HOME_RENDER=kind:out) on the PC's LÖVE."""
    hl = home_pack(os.path.join(os.path.dirname(out), "home-render.love"))
    env = dict(os.environ, HOME_RENDER=f"{kind}:{out}", HOME_HEADLESS="1", HOME_ART=art, SDL_VIDEODRIVER="offscreen",
               HOME_SHOW_ART=os.path.join(HERE, "out", "show-art"),
               SDL_AUDIODRIVER="dummy", ALSOFT_DRIVERS="null")
    subprocess.run([LOVE_X86, hl], env=env, check=True, capture_output=True, timeout=120)
    if not os.path.exists(out):
        die(f"Home did not render {kind}")
    return out


def cmd_love_pack(a):
    print(love_pack(a.out))


def cmd_home_pack(a):
    print(home_pack(a.out))


def cmd_love(a):
    if not os.path.exists(LOVE_X86):
        die("build LÖVE for this PC first: games/love/build.sh x86")
    yl = love_pack()
    e = dict(os.environ)
    e.setdefault("YARD_CARTS", CARTS)
    e["YARD_WINDOWED"] = "1"
    e.setdefault("SDL_VIDEODRIVER", "x11")
    d = tempfile.mkdtemp(prefix="cart-love-")
    print(f"saves go to {d}. Keys: arrows, Z X C, 1+2 held to quit, Esc.")
    subprocess.run([LOVE_X86, yl] + ([a.id] if a.id else []), cwd=d, env=e)


# ---------------------------------------------------------------------------- deploy

def pad(src, dst, slot):
    data = open(src, "rb").read()
    if len(data) > slot:
        die(f"{src} is {len(data)} bytes, over its {slot}-byte slot")
    open(dst, "wb").write(data + b"\0" * (slot - len(data)))


def cmd_deploy(a):
    """Offline staging only. Prints the plan; the restore needs the user's written approval."""
    out = os.path.abspath(a.out)
    if out.startswith(ROOT + os.sep):
        die("--out must be outside the repo (under ~/partycade-dumps/)")
    os.makedirs(out, exist_ok=True)
    stage = os.path.join(out, "stage")
    os.makedirs(stage, exist_ok=True)
    print("1. Building for the cabinet (./build.sh cab)")
    subprocess.check_call(["./build.sh", "cab"], cwd=HERE)
    print("2. Packing the carts")
    extra = [os.path.join(HERE, "love", "label", n) for n in ("loveprobe", "loveyard", "classic")] if a.with_love_probe else []
    if a.with_sysprobe:
        extra.append(os.path.join(HERE, "sysprobe", "label", "sysprobe"))
    pak = cmd_pack(argparse.Namespace(out=os.path.join(stage, "yard.pak"), extra=extra))
    pad(os.path.join(HERE, "out", "cab", "yard"), os.path.join(stage, "yard"), SLOTS["yard"])
    pad(os.path.join(HERE, "out", "cab", "orb"), os.path.join(stage, "orb"), SLOTS["orb"])
    cmd = [sys.executable, os.path.join(ROOT, "tools", "data_patch.py"), os.path.abspath(a.raw), out]
    if a.repair:
        cmd.append("--repair")
    names = ("yard", "orb", "yard.pak")
    if a.first:
        # The first time: the new runtime and pack go in as new files, the old C games come out
        # (their blocks were written before, so the new files can land on known pages), and
        # tile 10 points at yard.
        for old in a.remove:
            cmd += ["--rm", f"Games/{old}"]
        for n in names:
            cmd += ["--put", f"{os.path.join(stage, n)}:Games/{n}:{'644' if n.endswith('.pak') else '755'}"]
        if a.start_from:
            cmd += ["--replace", f"start.sh:{a.start_from}:GAME_NAME=yard"]
    elif a.reinstall:
        # The files are there but may have holes (deploys before 2026-10-25 let debugfs leave every zero
        # block unallocated). --put writes each again with every block allocated; after that, updates
        # are in place again.
        for n in names:
            cmd += ["--put", f"{os.path.join(stage, n)}:Games/{n}:{'644' if n.endswith('.pak') else '755'}"]
    else:
        # Every later time: same-size files, written into the blocks they already own.
        for n in names:
            cmd += ["--overwrite", f"{os.path.join(stage, n)}:Games/{n}"]
    if a.with_love_probe:
        # Two new files only: the bundle as one compressed tar, and its launcher. The cabinet unpacks the
        # tar itself on the first run (games/love/loveprobe.sh), an ordinary write by Linux.
        bundle = os.path.join(HERE, "out", "love-arm")
        if not os.path.exists(os.path.join(bundle, "love.bin")):
            print("   building LOVE for the cabinet (games/love/build.sh arm)")
            subprocess.check_call([os.path.join(HERE, "love", "build.sh"), "arm"])
        subprocess.check_call([sys.executable, os.path.join(HERE, "love", "check_abi.py"), bundle])
        tgz = os.path.join(stage, "love.tar.gz")
        tree = os.path.join(stage, "love-tree")
        shutil.rmtree(tree, ignore_errors=True)
        shutil.copytree(bundle, tree, symlinks=True)
        # Games ship as .love files (a zip). Under qemu a game folder failed to mount; a .love never has.
        probe = os.path.join(HERE, "love", "probe")
        zip_files(os.path.join(tree, "probe.love"),
                  [(os.path.join(r, f), os.path.relpath(os.path.join(r, f), probe))
                   for r, _, fs in os.walk(probe) for f in fs])
        love_pack(os.path.join(tree, "yard.love"))
        # Reproducible: sorted names, one date, no name or date in the gzip header.
        subprocess.check_call(f"tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner -C '{tree}' -cf - . "
                              f"| gzip -n -9 > '{tgz}'", shell=True)
        launcher = os.path.join(HERE, "love", "loveprobe.sh")
        cmd += ["--put", f"{tgz}:Games/love.tar.gz:644",
                "--put", f"{launcher}:Games/loveprobe:755",
                "--put", f"{launcher}:Games/loveyard:755"]
        names = names + ("love.tar.gz", "loveprobe", "loveyard")
    if a.with_net:
        # The network helper (games/net/yardnet.sh) and, if given, the SSH keys it lets in as root.
        cmd += ["--put", f"{os.path.join(HERE, 'net', 'yardnet.sh')}:Games/yardnet:755"]
        names = names + ("yardnet",)
        if a.ssh_key:
            key = open(os.path.expanduser(a.ssh_key)).read()
            if not re.match(r"^(ssh-(rsa|ed25519|dss)|ecdsa-sha2-\S+) \S+", key.strip()):
                die(f"{a.ssh_key} does not look like a public key (ssh-rsa/ecdsa-sha2-... ); give the .pub file")
            # The cabinet's dropbear is 2019.78: no ed25519 (that came in 2020.79). Verified 2026-10-26: an
            # ed25519 key was installed and refused. Use ECDSA or RSA (ssh-keygen -t ecdsa).
            if any(l.startswith("ssh-ed25519") for l in key.splitlines()):
                die(f"{a.ssh_key} has an ssh-ed25519 key, which the cabinet's dropbear 2019.78 refuses; "
                    "use ssh-keygen -t ecdsa (or rsa)")
            keys = os.path.join(stage, "yardnet.keys")
            open(keys, "w").write(key.strip() + "\n")
            cmd += ["--put", f"{keys}:Games/yardnet.keys:600"]
            names = names + ("yardnet.keys",)
    if a.with_wifi:
        # The Wi-Fi bundle (games/net/wifi/build.sh): cfg80211.ko, 8821au.ko, wpa_supplicant, as one tar
        # that yardnet unpacks on the cabinet. It needs --with-net (yardnet is what loads it).
        if not a.with_net:
            die("--with-wifi needs --with-net: yardnet is what loads the Wi-Fi driver")
        wtgz = os.path.join(HERE, "out", "wifi", "wifi.tar.gz")
        if not os.path.exists(wtgz):
            print("   building the Wi-Fi bundle (games/net/wifi/build.sh)")
            subprocess.check_call([os.path.join(HERE, "net", "wifi", "build.sh")])
        cmd += ["--put", f"{wtgz}:Games/wifi.tar.gz:644"]
        names = names + ("wifi.tar.gz",)
    if a.wifi_conf:
        conf = open(os.path.expanduser(a.wifi_conf)).read()
        if "network={" not in conf:
            die(f"{a.wifi_conf} is not a wpa_supplicant config (no network={{...}}); make one with wpa_passphrase")
        cmd += ["--put", f"{os.path.abspath(os.path.expanduser(a.wifi_conf))}:Games/wifi.conf:600"]
        names = names + ("wifi.conf",)
    if a.with_sysprobe:
        # One small new file: a read-only shell script that records what Linux sees (FIELD_TASKS.md).
        cmd += ["--put", f"{os.path.join(HERE, 'sysprobe', 'sysprobe.sh')}:Games/sysprobe:755"]
        names = names + ("sysprobe",)
    print("3. Patching a copy of the raw dump (offline)\n   " + " ".join(cmd))
    r = subprocess.run(cmd, capture_output=True, text=True)
    print(r.stdout + r.stderr)
    if r.returncode:
        if "has holes" in r.stdout + r.stderr:
            print("A file on the cabinet has unallocated blocks (an older deploy). Run the same command with")
            print("--reinstall once; it writes the files whole, and later deploys update them in place.")
        if "no physical copy" in r.stdout + r.stderr:
            print("The new files landed on disk pages that have never been written, which the in-place patch")
            print("cannot reach. Try --first with --remove of the old C game binaries so their blocks are reused,")
            print("or put the files on the microSD card once the slot is on (GAMEDEV.md § 9).")
        die("staging stopped; nothing was written to the cabinet")
    blocks = open(os.path.join(out, "BLOCKS.txt")).read().strip()
    plan = os.path.join(out, "PLAN.md")
    with open(plan, "w") as f:
        f.write(f"# Deploy plan\n\nRaw dump: `{os.path.abspath(a.raw)}`\n\nFiles:\n\n")
        for n in names:
            new = a.first or a.reinstall or n in ("love.tar.gz", "loveprobe", "loveyard", "sysprobe", "yardnet",
                                                 "yardnet.keys", "wifi.tar.gz", "wifi.conf")
            f.write(f"* `/data/Games/{n}` ({'new' if new else 'in place'})\n")
        f.write(f"\nBlocks to write: `{blocks}`\n\nBefore: `rk_restore.py diff` of the raw dump in the same Mask ROM "
                "session must report none. Then, only with the user's written approval of exactly these blocks:\n\n"
                f"```\nPARTYCADE_ALLOW_NAND_WRITE=yes python3 tools/rk_restore.py restore {out}/nand_raw_patched.bin "
                f"--blocks {blocks} --approval '<the user's approval text>'\n```\n")
    print(f"Plan: {plan}\nNothing was written to the cabinet.")


def cmd_push(a):
    """Install over Wi-Fi (no Mask ROM): the runtime, Orb, the pack, and the GPU yard's .love, each only if it
    changed. Slot files (yard, orb, yard.pak) are written into the blocks they own (dd conv=notrunc: /userdata
    is ~96% full); the rest are rewritten. Every file is checked by sha256 afterwards. Refuses while The Yard
    runs. Needs the cabinet's SSH key (tools/cab.sh)."""
    import hashlib
    r = subprocess.run([os.path.join(ROOT, "tools", "cab.sh"), "host"], capture_output=True, text=True)
    if r.returncode != 0:
        die(r.stderr.strip() or "cabinet not found")
    host = r.stdout.strip()
    key = os.path.expanduser("~/yard_key_ecdsa")
    sshopt = ["-i", key, "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
              "-o", "LogLevel=ERROR", "-o", "ConnectTimeout=8"]
    def ssh(cmd):
        return subprocess.run(["ssh"] + sshopt + [f"root@{host}", cmd], capture_output=True, text=True)
    stage = tempfile.mkdtemp(prefix="cart-push-")
    print("1. Building for the cabinet")
    subprocess.check_call(["./build.sh", "cab"], cwd=HERE, stdout=subprocess.DEVNULL)
    # (The "Home preview" row went when Home became the front end, 2026-10-27: it would open Home inside Home.)
    extra = [os.path.join(HERE, "love", "label", n) for n in ("loveprobe", "loveyard", "classic")]
    extra.append(os.path.join(HERE, "sysprobe", "label", "sysprobe"))
    cmd_pack(argparse.Namespace(out=os.path.join(stage, "yard.pak.raw"), extra=extra))
    files = {}
    pad(os.path.join(stage, "yard.pak.raw"), os.path.join(stage, "yard.pak"), SLOTS["yard.pak"])
    pad(os.path.join(HERE, "out", "cab", "yard"), os.path.join(stage, "yard"), SLOTS["yard"])
    pad(os.path.join(HERE, "out", "cab", "orb"), os.path.join(stage, "orb"), SLOTS["orb"])
    for n in ("yard", "orb", "yard.pak"):
        files[f"/data/Games/{n}"] = (os.path.join(stage, n), True)
    files["/data/love/yard.love"] = (love_pack(os.path.join(stage, "yard.love")), False)
    for n in ("loveyard", "loveprobe"):
        files[f"/data/Games/{n}"] = (os.path.join(HERE, "love", "loveprobe.sh"), False)
    files["/data/Games/yardnet"] = (os.path.join(HERE, "net", "yardnet.sh"), False)
    # Partycade Home: the app, its loop, the Yard's preview row, and the classics' logo cards (cut from the stock
    # menu's pictures on the PC by tools/home_art.py from the rootfs dump; they never go into git).
    files["/data/home/home.love"] = (home_pack(os.path.join(stage, "home.love")), False)
    files["/data/home/homeloop"] = (os.path.join(HERE, "love", "home", "homeloop.sh"), False)
    files["/data/Games/homepreview"] = (os.path.join(HERE, "love", "home", "homepreview.sh"), False)
    art = os.path.join(HERE, "out", "home-art")
    tool = os.path.join(ROOT, "tools", "home_art.py")
    stamp = os.path.join(art, "classic_0.png")
    if not os.path.exists(stamp) or os.path.getmtime(stamp) < os.path.getmtime(tool):
        rootfs = os.path.expanduser("~/partycade-dumps/2026-10-23_raw_plug3032slc/rootfs")
        subprocess.check_call([sys.executable, tool, rootfs, art], stdout=subprocess.DEVNULL)
    for f in sorted(os.listdir(art)):
        files[f"/data/home/art/{f}"] = (os.path.join(art, f), False)
    # holdwatch (ticks while a classic's exit button is held), its sounds, and the dmix config it needs.
    hw = os.path.join(HERE, "out", "cab", "holdwatch")
    hsrc = os.path.join(HERE, "love", "home", "holdwatch.c")
    if not os.path.exists(hw) or os.path.getmtime(hw) < os.path.getmtime(hsrc):
        subprocess.check_call(["docker", "run", "--rm", "-u", f"{os.getuid()}:{os.getgid()}", "-v", f"{HERE}:/src",
                               "-w", "/src", "partycade-armhf", "arm-linux-gnueabihf-gcc", "-O2", "-static", "-Wall",
                               "-o", "out/cab/holdwatch", "love/home/holdwatch.c"])
    files["/data/home/holdwatch"] = (hw, False)
    files["/data/home/alsa.conf"] = (os.path.join(HERE, "love", "home", "alsa.conf"), False)
    sfx = os.path.join(stage, "sfx")
    subprocess.check_call([sys.executable, os.path.join(ROOT, "tools", "home_sfx.py"), sfx], stdout=subprocess.DEVNULL)
    for f in sorted(os.listdir(sfx)):
        files[f"/data/home/sfx/{f}"] = (os.path.join(sfx, f), False)
    # Live TV (games/tv): the player, the fetcher and the loop between them. Built by games/tv/build.sh (MPP and
    # the cabinet's FFmpeg); the playlists' logins (/data/tv/account.conf) are never part of a push.
    tvout = os.path.join(HERE, "out", "cab")
    if not all(os.path.exists(os.path.join(tvout, n)) for n in ("tvplay", "tvnet", "tvfont.gz")):
        subprocess.check_call([os.path.join(HERE, "tv", "build.sh")], stdout=subprocess.DEVNULL)
    files["/data/tv/bin/tvplay"] = (os.path.join(tvout, "tvplay"), False)
    files["/data/tv/bin/tvnet"] = (os.path.join(tvout, "tvnet"), False)
    files["/data/tv/bin/tvloop"] = (os.path.join(HERE, "tv", "tvloop.sh"), False)
    files["/data/tv/tvfont.gz"] = (os.path.join(tvout, "tvfont.gz"), False)
    # Home at power-on: stage2 (v2) binds games/boot/S50ui over the stock one (games/boot/README.md).
    files["/data/boot/stage2.sh"] = (os.path.join(HERE, "boot", "stage2.sh"), False)
    files["/data/boot/S50ui"] = (os.path.join(HERE, "boot", "S50ui"), False)
    # The power-on picture (stage2 puts it in /dev/fb0 at ~2.5 s): rendered by Home itself, on the PC.
    files["/data/home/boot.fb.gz"] = (home_picture("boot", os.path.join(stage, "boot.fb.gz"), art), False)
    # The shows' painted pictures (tools/show_art.py) go to the SD card, when one is mounted (never to /data, ~96%
    # full; without them the shows draw their scenes live).
    thumbs = os.path.join(HERE, "love", "home", "thumbs")
    if os.path.isdir(thumbs) and ssh("grep -q ' /mnt/sdcard ' /proc/mounts && echo card").stdout.strip() == "card":
        for f in sorted(os.listdir(thumbs)):
            if f.endswith(".png"):
                files[f"/mnt/sdcard/partycade/thumbs/{f}"] = (os.path.join(thumbs, f), False)
    show_art = os.path.join(HERE, "out", "show-art")
    if os.path.isdir(show_art) and ssh("grep -q ' /mnt/sdcard ' /proc/mounts && echo card").stdout.strip() == "card":
        for sid in sorted(os.listdir(show_art)):
            for f in sorted(os.listdir(os.path.join(show_art, sid))):
                base, ext = os.path.splitext(f)
                if ext == ".pkm" or (ext == ".png" and not base.endswith(".etc1") and
                                     not os.path.exists(os.path.join(show_art, sid, base + ".pkm"))):
                    files[f"/mnt/sdcard/partycade/art/{sid}/{f}"] = (os.path.join(show_art, sid, f), False)
    # The Shelf (games/native/play): the player and its libretro cores live on the card beside the games
    # (/data has no room). Cores come from games/shelf/build_cores.sh (~/partycade-build/cores). The library
    # itself (games, index, art) is tools/shelf_sync.sh.
    play_bin = os.path.join(HERE, "out", "cab", "play")
    cores = os.path.expanduser("~/partycade-build/cores")
    if os.path.exists(play_bin) and ssh("grep -q ' /mnt/sdcard ' /proc/mounts && echo card").stdout.strip() == "card":
        files["/mnt/sdcard/library/bin/play"] = (play_bin, False)
        for f in sorted(os.listdir(cores)) if os.path.isdir(cores) else []:
            if f.endswith(".so"):
                files[f"/mnt/sdcard/library/cores/{f}"] = (os.path.join(cores, f), False)
    for extra_file in a.also or []:
        src, dst = extra_file.split(":", 1)
        files[dst] = (os.path.abspath(src), False)
    # Someone playing: The Yard, a LÖVE program other than Home, or a game started from /data/Games (a classic,
    # Orb). Home on its own (the front end since 2026-10-27) is stopped for the install and started again.
    busy_check = ("pidof yard >/dev/null && echo busy; "
                  "for p in $(pidof love.bin); do grep -q home.love /proc/$p/cmdline || echo busy; done; "
                  "pidof PacMan SuperPacMan PacLand NS1 Galaga Galaxian Mappy DigDug orb start.sh play >/dev/null && echo busy; "
                  "pidof tvloop tvplay >/dev/null && echo busy; "
                  "pidof homeloop >/dev/null && echo home; ")
    # (the list over stdin: with the shows' pictures it is too long for one command line)
    r = subprocess.run(["ssh"] + sshopt + [f"root@{host}", busy_check + "xargs sha256sum 2>/dev/null"],
                       input="\n".join(files) + "\n", capture_output=True, text=True)
    if r.returncode not in (0, 1) and not r.stdout:
        die(f"cannot reach the cabinet at {host}: {r.stderr.strip()} (is The Yard opened once since boot, for Wi-Fi?)")
    if "busy" in r.stdout.split():
        die("a game, The Yard, GPU yard or live TV is running on the cabinet: leave it first, nothing was changed")
    home_up = "home" in r.stdout.split()
    if home_up:
        print("   Home is on the screen: stopped for the install, started again after")
        ssh("for p in $(pidof homeloop) $(pidof love.bin); do kill -9 $p; done; sleep 0.5")
    have = {l.split()[1]: l.split()[0] for l in r.stdout.splitlines() if len(l.split()) == 2}
    print("2. Installing")
    changed = 0
    try:
        changed = push_files(files, have, host, sshopt, ssh)
    finally:
        if home_up:
            ssh("(setsid /data/home/homeloop </dev/null >/dev/null 2>&1 &)")
            print("   Home started again")
    shutil.rmtree(stage, ignore_errors=True)
    print(f"{changed} file(s) changed. A Mask ROM deploy must start from a fresh dump now (STATUS.md).")


def push_files(files, have, host, sshopt, ssh):
    """cmd_push's install step: each changed file copied, checked by sha256, put in place."""
    import hashlib
    changed = 0
    for dst, (src, slot) in files.items():
        want = hashlib.sha256(open(src, "rb").read()).hexdigest()
        if have.get(dst) == want:
            print(f"   {dst}: unchanged")
            continue
        tmp = "/tmp/cart-push." + os.path.basename(dst)
        subprocess.check_call(["scp", "-O", "-q"] + sshopt + [src, f"root@{host}:{tmp}"])
        if slot:
            how = f"dd if={tmp} of={dst} bs=65536 conv=notrunc,fsync 2>/dev/null"
        else:
            # A new file renamed over the old one: a running script (yardnet) keeps reading its old copy.
            mode = "644" if dst.endswith((".love", ".pak", ".keys", ".txt", ".conf", ".png", ".wav", ".pkm")) else "755"
            how = (f"mkdir -p {os.path.dirname(dst)} && cp {tmp} {dst}.new && chmod {mode} {dst}.new && "
                   f"mv -f {dst}.new {dst}")
        r = ssh(f"[ \"$(sha256sum {tmp} | cut -d' ' -f1)\" = {want} ] && {how} && sync && rm -f {tmp} && sha256sum {dst}")
        if want not in r.stdout:
            die(f"{dst}: the copy did not check out ({r.stdout.strip()} {r.stderr.strip()})")
        print(f"   {dst}: installed ({want[:12]})")
        changed += 1
    return changed


