#!/usr/bin/env python3
"""cart: make, check, and ship Yard carts. Everything here runs on the PC; nothing touches the cabinet.

  ./cart new ID [--from blank|arcade|story] [--title T] [--large]   start a cart from a template
  ./cart list                                     every cart the runtime can see
  ./cart run ID [--fast]                          play it in a window; edits reload live (YARD_DEV)
  ./cart check [ID ...]                           the gate: lint, a played session, a mashed session,
                                                  pictures to look at, the frame cost (default: all)
  ./cart shots ID [FRAME ...] [--auto]            PNG pictures of chosen frames, in out/shots/ID/
  ./cart perf ID [--frames N]                     instructions per frame (callgrind), against the budget
  ./cart pack [--out FILE]                        build yard.pak: every cart, padded to its fixed slot
  ./cart deploy --raw RAW --out DIR [--first]     stage yard, orb, and yard.pak onto a copy of a raw dump
                [--with-love-probe]               ... plus LÖVE, its probe, and a "GPU yard" row (FIELD_TASKS.md)
                [--with-sysprobe]                 ... plus the read-only "System probe" row (FIELD_TASKS.md)
  ./cart love [ID]                                play on LÖVE, the GPU runtime (games/love/build.sh x86 first)
  ./cart love-pack [--out FILE]                   build yard.love: the LÖVE runtime, library, and font

A cart is a folder in carts/: info.lua (the label: title, blurb, icon, stat) and main.lua (the game),
plus any other .lua it imports, .png pictures, and .txt data. CARTS.md is the API. GAMEDEV.md the rules.
"""
import argparse
import json
import os
import random
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import zlib

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
CARTS = os.path.join(HERE, "carts")
TEMPLATES = os.path.join(HERE, "templates")
YARD = os.path.join(HERE, "out", "pc", "yard")
ALLOWED = (".lua", ".png", ".txt", ".ttf", ".md")
MAX_FILE = 512 * 1024
# Slots on the cabinet: each file is padded to this size so an update rewrites the blocks it
# already has (data_patch.py --overwrite) instead of asking the disk for new ones.
SLOTS = {"yard": 2 << 20, "orb": 1 << 20, "yard.pak": 4 << 20}
# Frame budget, in PC (x86) instructions per frame measured by callgrind. Tea, the busiest
# cart, runs at about 7.1M; the Cortex-A7 at 1 GHz holds 60 frames a second up to roughly
# 9M by this yardstick (an estimate from the C builds that ran on the cabinet; see STATUS.md).
BUDGET = 9_000_000
GOOD = "\033[32m" if sys.stdout.isatty() else ""
BAD = "\033[31m" if sys.stdout.isatty() else ""
END = "\033[0m" if sys.stdout.isatty() else ""


def die(msg):
    print(f"{BAD}{msg}{END}")
    sys.exit(1)


def build():
    r = subprocess.run(["make", "-s", "TARGET=pc"], cwd=HERE, capture_output=True, text=True)
    if r.returncode:
        die("build failed:\n" + r.stdout + r.stderr)


def carts():
    out = []
    for name in sorted(os.listdir(CARTS)):
        if os.path.isfile(os.path.join(CARTS, name, "info.lua")):
            out.append(name)
    return out


def env(extra=None):
    e = dict(os.environ)
    e.update({"SDL_VIDEODRIVER": "dummy", "SDL_AUDIODRIVER": "dummy", "CAB_SCALE": "1"})
    e.update(extra or {})
    return e


def native(cid):
    text = open(os.path.join(CARTS, cid, "info.lua")).read()
    m = re.search(r'native\s*=\s*"([a-z0-9_-]+)"', text)
    return m.group(1) if m else None


def bmp_to_png(src, dst):
    try:
        from PIL import Image
        Image.open(src).save(dst)
        os.remove(src)
        return dst
    except Exception:
        return src


# ---------------------------------------------------------------------------- new

def cmd_new(a):
    cid = a.id
    if not re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", cid):
        die("an id is lower-case letters, digits, _ or -, starting with a letter, up to 32 long")
    if cid in ("yard", "orb", "probe"):
        die(f"{cid} is taken")
    dst = os.path.join(CARTS, cid)
    if os.path.exists(dst):
        die(f"carts/{cid} already exists")
    src = os.path.join(TEMPLATES, a.template)
    if not os.path.isdir(src):
        die(f"no template {a.template}; there are: {', '.join(sorted(os.listdir(TEMPLATES)))}")
    os.makedirs(dst)
    title = a.title or cid.replace("_", " ").replace("-", " ").title()
    for name in os.listdir(src):
        text = open(os.path.join(src, name)).read()
        text = text.replace("{{ID}}", cid).replace("{{TITLE}}", title).replace("{{SIZE}}", "large" if a.large else "small")
        open(os.path.join(dst, name), "w").write(text)
    print(f"made carts/{cid} from the {a.template} template")
    print(f"  ./cart run {cid}      play it (edits reload while it runs)")
    print(f"  ./cart check {cid}    the gate before anything ships")


# ---------------------------------------------------------------------------- list / run

def cmd_list(a):
    build()
    subprocess.run([YARD, "--list"], cwd=HERE)


def cmd_run(a):
    build()
    e = dict(os.environ)
    e["YARD_DEV"] = "1"
    args = [YARD, a.id] + (["-fast"] if a.fast else [])
    d = tempfile.mkdtemp(prefix="cart-run-")
    print(f"saves go to {d}. Keys: arrows, Z X C (the three buttons), 1+2 held to quit, Esc.")
    subprocess.run(args, cwd=d, env=e)


# ---------------------------------------------------------------------------- check

def lint(cid):
    """Problems that do not need the game to run."""
    problems, d, total = [], os.path.join(CARTS, cid), 0
    if not os.path.isfile(os.path.join(d, "main.lua")) and not native(cid):
        problems.append("no main.lua")
    for dirpath, _, files in os.walk(d):
        for f in files:
            p = os.path.join(dirpath, f)
            rel = os.path.relpath(p, d)
            size = os.path.getsize(p)
            total += size
            if not f.endswith(ALLOWED):
                problems.append(f"{rel}: only {' '.join(ALLOWED)} files ship in a cart")
            if not re.fullmatch(r"[A-Za-z0-9_./-]+", rel):
                problems.append(f"{rel}: file names are letters, digits, _ - . only")
            if size > MAX_FILE:
                problems.append(f"{rel}: {size // 1024} KB; keep files under {MAX_FILE // 1024} KB")
            if f.endswith(".lua"):
                text = open(p, errors="replace").read()
                for n, line in enumerate(text.splitlines(), 1):
                    code = line.split("--")[0]
                    if re.search(r"\b(os|io|debug|package)\.", code) or re.search(r"\b(require|loadstring|dofile)\s*\(", code):
                        problems.append(f"{rel}:{n}: carts cannot reach os, io, debug, package, require: {line.strip()[:60]}")
                    bare = re.sub(r'"(\\.|[^"\\])*"|\'(\\.|[^\'\\])*\'', '""', code)
                    m = re.search(r"//|<<|>>|[^~=<>]~[^=]|\s[&|]\s|\butf8\.|\bmath\.(type|tointeger|ult)\b|\btable\.move\b|\bstring\.(pack|unpack)\b", bare)
                    if m:
                        problems.append(f"{rel}:{n}: '{m.group(0).strip()}' is Lua 5.3+; carts use the Lua both runtimes speak "
                                        f"(5.1 with goto; idiv(a, b) for //): {line.strip()[:60]}")
                    m = re.search(r"\bmath\.atan\s*\([^()]*,|\bmath\.atan2\b|\btable\.unpack\b|\btable\.pack\b|\bmath\.pow\b|"
                                  r"\bmath\.log\s*\([^()]*,|\bloadstring\b|\bsetfenv\b|\bmath\.maxinteger\b", bare)
                    if m:
                        problems.append(f"{rel}:{n}: '{m.group(0).strip()}' differs between Lua 5.1 (LÖVE) and 5.4; use the "
                                        f"library's atan2(y, x), unpack(t), x ^ y, or math.log(x) / math.log(b): {line.strip()[:60]}")
                    if "\t" in line[: len(line) - len(line.lstrip())]:
                        problems.append(f"{rel}:{n}: indent with spaces")
    luajit = shutil.which("luajit") or next((p for p in (os.path.join(HERE, "out", "love-x86", "luajit"),) if os.path.exists(p)), None)
    if luajit:
        # Parse every file the way LuaJIT (LÖVE) will.
        for dirpath, _, files in os.walk(d):
            for f in files:
                if f.endswith(".lua"):
                    # -b compiles to bytecode without running anything.
                    r = subprocess.run([luajit, "-b", os.path.join(dirpath, f), os.devnull],
                                       capture_output=True, text=True)
                    if r.returncode:
                        problems.append(f"{os.path.relpath(os.path.join(dirpath, f), d)}: LuaJIT cannot parse it: "
                                        f"{(r.stderr.strip().splitlines() or ['?'])[0][:120]}")
    if total > 2 * 1024 * 1024:
        problems.append(f"the cart is {total // 1024} KB; keep a cart under 2 MB")
    return problems


def run_check(cid, frames, script=None, extra=None):
    """Run the cart headless through the runtime's --check. Returns (ok, stdout+log)."""
    d = tempfile.mkdtemp(prefix="cart-check-")
    # CAB_MAX_FRAMES also stops a cart the menu launches mid-check (a separate process, not in check mode),
    # which would otherwise run on forever once the script ran out.
    e = env({"YARD_CHECK_FRAMES": str(frames), "CAB_MAX_FRAMES": str(frames + 1)})
    e.update(extra or {})
    if script is not None:
        path = os.path.join(d, "deck.cab")
        open(path, "w").write(script)
        e["CAB_SCRIPT"] = path
    try:
        r = subprocess.run([YARD, "--check", cid], cwd=d, env=e, capture_output=True, text=True, timeout=300)
    except subprocess.TimeoutExpired:
        return False, "timed out (more than 5 minutes for the session)", d
    out = r.stdout + r.stderr
    return r.returncode == 0 and "\nerror:" not in "\n" + r.stdout, out, d


def mash(seed, frames):
    """A small child at the deck: random presses, holds, and releases on every button."""
    rng = random.Random(seed)
    names = ["UP", "DOWN", "LEFT", "RIGHT", "LOW", "TL", "TR"]
    lines, held = [], set()
    f = 0
    while f < frames:
        f += rng.randint(1, 12)
        b = rng.choice(names)
        if b in held:
            lines.append(f"{f} up {b}")
            held.discard(b)
        else:
            lines.append(f"{f} down {b}")
            held.add(b)
    return "\n".join(lines) + "\n"


def shots(cid, frames, autoplay=True, folder=None):
    folder = folder or os.path.join(HERE, "out", "shots", cid)
    shutil.rmtree(folder, ignore_errors=True)
    os.makedirs(folder)
    script = "".join(f"{f} shot {folder}/{cid}-{f}.bmp\n" for f in frames)
    ok, out, _ = run_check(cid, max(frames) + 1, script, {"CAB_AUTOPLAY": "1"} if autoplay else None)
    made = []
    for f in frames:
        p = os.path.join(folder, f"{cid}-{f}.bmp")
        if os.path.exists(p):
            made.append(bmp_to_png(p, p[:-4] + ".png"))
    return ok, out, made


def sheet(paths, dst):
    """One picture of several frames side by side, to look at in one go."""
    try:
        from PIL import Image
    except ImportError:
        return None
    ims = [Image.open(p) for p in paths]
    if not ims:
        return None
    w, h = ims[0].size
    out = Image.new("RGB", (len(ims) * (w + 6) - 6, h), (40, 40, 40))
    for i, im in enumerate(ims):
        out.paste(im, (i * (w + 6), 0))
    out.save(dst)
    return dst


def perf(cid, frames=600):
    """x86 instructions per frame over an autoplayed session, by callgrind. None if no valgrind."""
    if not shutil.which("valgrind"):
        return None
    d = tempfile.mkdtemp(prefix="cart-perf-")
    out = os.path.join(d, "cg.out")
    e = env({"CAB_AUTOPLAY": "1", "YARD_CHECK_FRAMES": str(frames), "CAB_SCRIPT": "/dev/null"})
    subprocess.run(["valgrind", "--tool=callgrind", f"--callgrind-out-file={out}", YARD, "--check", cid], cwd=d,
                   env=e, capture_output=True, timeout=1800)
    try:
        total = int(re.search(r"^summary:\s*(\d+)", open(out).read(), re.M).group(1))
    except (OSError, AttributeError):
        return None
    return total // frames


def verdict(out):
    for line in out.splitlines():
        if line.startswith(("ok:", "error:")):
            return line
    return out.strip().splitlines()[-1] if out.strip() else "no output"


def cmd_check(a):
    build()
    ids = a.ids or [c for c in carts() if not native(c)]
    failed = []
    for cid in ids:
        if not os.path.isdir(os.path.join(CARTS, cid)):
            die(f"no carts/{cid}")
        print(f"== {cid}")
        problems = lint(cid)
        for p in problems:
            print(f"  {BAD}lint{END} {p}")
        if native(cid):
            print("  native program: only the label is checked here")
            if problems:
                failed.append(cid)
            continue
        ok1, out1, _ = run_check(cid, 1800, "", {"CAB_AUTOPLAY": "1"})
        print(f"  {'ok  ' if ok1 else BAD + 'FAIL' + END} played by its bot() for 30 seconds: {verdict(out1)}")
        ok2, out2, _ = run_check(cid, 1800, mash(cid, 1800))
        print(f"  {'ok  ' if ok2 else BAD + 'FAIL' + END} mashed at random for 30 seconds: {verdict(out2)}")
        for ok, out in ((ok1, out1), (ok2, out2)):
            if not ok:
                print("    " + "\n    ".join(out.strip().splitlines()[-12:]))
        ok3, _, pics = shots(cid, [10, 300, 900])
        s = sheet(pics, os.path.join(HERE, "out", "shots", cid, "sheet.png"))
        print(f"  look at {os.path.relpath(s, HERE) if s else 'out/shots/' + cid}")
        cost = None if a.quick else perf(cid)
        if cost is not None:
            flag = cost <= BUDGET
            print(f"  {'ok  ' if flag else BAD + 'SLOW' + END} {cost / 1e6:.1f}M instructions a frame (budget {BUDGET / 1e6:.0f}M)")
        else:
            flag = True
        if problems or not (ok1 and ok2 and flag):
            failed.append(cid)
    print()
    if failed:
        die(f"not ready: {' '.join(failed)}")
    print(f"{GOOD}all carts pass{END}")


def cmd_shots(a):
    build()
    frames = [int(f) for f in a.frames] or [10, 120, 300, 600]
    ok, out, made = shots(a.id, frames, autoplay=a.auto)
    for m in made:
        print(os.path.relpath(m, HERE))
    if not ok:
        print(out)


def cmd_perf(a):
    build()
    cost = perf(a.id, a.frames)
    if cost is None:
        die("needs valgrind (apt install valgrind)")
    print(f"{a.id}: {cost / 1e6:.2f}M x86 instructions a frame; budget {BUDGET / 1e6:.0f}M "
          f"({'ok' if cost <= BUDGET else 'too slow for the cabinet'})")


# ---------------------------------------------------------------------------- pack

def pack_bytes(extra=()):
    """extra: more cart folders to include, by path (cart deploy --with-love-probe adds its label)."""
    entries = []
    folders = [(cid, os.path.join(CARTS, cid)) for cid in carts()] + [(os.path.basename(e), e) for e in extra]
    for cid, folder in folders:
        for dirpath, _, files in sorted(os.walk(folder)):
            for f in sorted(files):
                if not f.endswith(ALLOWED) or f.endswith(".md"):
                    continue
                p = os.path.join(dirpath, f)
                name = cid + "/" + os.path.relpath(p, folder).replace(os.sep, "/")
                entries.append((name, open(p, "rb").read()))
    body = b""
    for name, data in entries:
        n = name.encode()
        body += struct.pack("<H", len(n)) + n + struct.pack("<II", len(data), zlib.crc32(data) & 0xffffffff) + data
    head = b"YARDPAK1" + struct.pack("<II", len(entries), 16 + len(body))
    return head + body, entries


def cmd_pack(a):
    problems = [p for c in carts() for p in lint(c)]
    if problems:
        die("lint first:\n  " + "\n  ".join(problems))
    data, entries = pack_bytes(getattr(a, "extra", ()))
    slot = SLOTS["yard.pak"]
    if len(data) > slot:
        die(f"the carts need {len(data)} bytes; the yard.pak slot is {slot}")
    out = a.out or os.path.join(HERE, "out", "yard.pak")
    os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
    with open(out, "wb") as f:
        f.write(data + b"\0" * (slot - len(data)))
    print(f"{out}: {len(entries)} files, {len(data) // 1024} KB used of the {slot >> 20} MB slot")
    # Read it back through the runtime, exactly as the cabinet will.
    build()
    d = tempfile.mkdtemp(prefix="cart-pak-")
    r = subprocess.run([YARD, "--list"], cwd=d, env=env({"YARD_PAK": os.path.abspath(out), "YARD_CARTS": d}),
                       capture_output=True, text=True)
    print("  the runtime reads: " + ", ".join(l.split()[0] for l in r.stdout.splitlines() if "pak:" in l))
    return out


# ---------------------------------------------------------------------------- LÖVE

LOVE_X86 = os.path.join(HERE, "out", "love-x86", "run.sh")


def love_pack(out=None):
    """games/love/yard + the shared library + the round font -> a .love (a zip LÖVE runs)."""
    import zipfile
    out = out or os.path.join(HERE, "out", "yard.love")
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
        src = os.path.join(HERE, "love", "yard")
        for f in sorted(os.listdir(src)):
            if f.endswith(".lua"):
                z.write(os.path.join(src, f), f)
        lib = os.path.join(HERE, "engine", "lib")
        for f in sorted(os.listdir(lib)):
            if f.endswith(".lua"):
                z.write(os.path.join(lib, f), "lib/" + f)
        z.write(os.path.join(HERE, "engine", "fonts", "Fredoka-SemiBold.ttf"), "fonts/Fredoka-SemiBold.ttf")
    return out


def cmd_love_pack(a):
    print(love_pack(a.out))


def cmd_love(a):
    if not os.path.exists(LOVE_X86):
        die("build LÖVE for this PC first: games/love/build.sh x86")
    yl = love_pack()
    e = dict(os.environ)
    e.setdefault("YARD_CARTS", CARTS)
    e["YARD_WINDOWED"] = "1"
    e.setdefault("SDL_VIDEODRIVER", "x11")
    d = tempfile.mkdtemp(prefix="cart-love-")
    print(f"saves go to {d}. Keys: arrows, Z X C, 1+2 held to quit, Esc.")
    subprocess.run([LOVE_X86, yl] + ([a.id] if a.id else []), cwd=d, env=e)


# ---------------------------------------------------------------------------- deploy

def pad(src, dst, slot):
    data = open(src, "rb").read()
    if len(data) > slot:
        die(f"{src} is {len(data)} bytes, over its {slot}-byte slot")
    open(dst, "wb").write(data + b"\0" * (slot - len(data)))


def cmd_deploy(a):
    """Offline staging only. Prints the plan; the restore needs the user's written approval."""
    out = os.path.abspath(a.out)
    if out.startswith(ROOT + os.sep):
        die("--out must be outside the repo (under ~/partycade-dumps/)")
    os.makedirs(out, exist_ok=True)
    stage = os.path.join(out, "stage")
    os.makedirs(stage, exist_ok=True)
    print("1. Building for the cabinet (./build.sh cab)")
    subprocess.check_call(["./build.sh", "cab"], cwd=HERE)
    print("2. Packing the carts")
    extra = [os.path.join(HERE, "love", "label", n) for n in ("loveprobe", "loveyard")] if a.with_love_probe else []
    if a.with_sysprobe:
        extra.append(os.path.join(HERE, "sysprobe", "label", "sysprobe"))
    pak = cmd_pack(argparse.Namespace(out=os.path.join(stage, "yard.pak"), extra=extra))
    pad(os.path.join(HERE, "out", "cab", "yard"), os.path.join(stage, "yard"), SLOTS["yard"])
    pad(os.path.join(HERE, "out", "cab", "orb"), os.path.join(stage, "orb"), SLOTS["orb"])
    cmd = [sys.executable, os.path.join(ROOT, "tools", "data_patch.py"), os.path.abspath(a.raw), out]
    names = ("yard", "orb", "yard.pak")
    if a.first:
        # The first time: the new runtime and pack go in as new files, the old C games come out
        # (their blocks were written before, so the new files can land on known pages), and
        # tile 10 points at yard.
        for old in a.remove:
            cmd += ["--rm", f"Games/{old}"]
        for n in names:
            cmd += ["--put", f"{os.path.join(stage, n)}:Games/{n}:{'644' if n.endswith('.pak') else '755'}"]
        if a.start_from:
            cmd += ["--replace", f"start.sh:{a.start_from}:GAME_NAME=yard"]
    else:
        # Every later time: same-size files, written into the blocks they already own.
        for n in names:
            cmd += ["--overwrite", f"{os.path.join(stage, n)}:Games/{n}"]
    if a.with_love_probe:
        # Two new files only: the bundle as one compressed tar, and its launcher. The cabinet unpacks the
        # tar itself on the first run (games/love/loveprobe.sh), an ordinary write by Linux.
        bundle = os.path.join(HERE, "out", "love-arm")
        if not os.path.exists(os.path.join(bundle, "love.bin")):
            print("   building LOVE for the cabinet (games/love/build.sh arm)")
            subprocess.check_call([os.path.join(HERE, "love", "build.sh"), "arm"])
        subprocess.check_call([sys.executable, os.path.join(HERE, "love", "check_abi.py"), bundle])
        tgz = os.path.join(stage, "love.tar.gz")
        tree = os.path.join(stage, "love-tree")
        shutil.rmtree(tree, ignore_errors=True)
        shutil.copytree(bundle, tree, symlinks=True)
        # Games ship as .love files (a zip). Under qemu a game folder failed to mount; a .love never has.
        subprocess.check_call(["zip", "-q", "-r", "-X", os.path.join(tree, "probe.love"), "."],
                              cwd=os.path.join(HERE, "love", "probe"))
        love_pack(os.path.join(tree, "yard.love"))
        subprocess.check_call(["tar", "-czf", tgz, "--owner=0", "--group=0", "-C", tree, "."])
        launcher = os.path.join(HERE, "love", "loveprobe.sh")
        cmd += ["--put", f"{tgz}:Games/love.tar.gz:644",
                "--put", f"{launcher}:Games/loveprobe:755",
                "--put", f"{launcher}:Games/loveyard:755"]
        names = names + ("love.tar.gz", "loveprobe", "loveyard")
    if a.with_sysprobe:
        # One small new file: a read-only shell script that records what Linux sees (FIELD_TASKS.md).
        cmd += ["--put", f"{os.path.join(HERE, 'sysprobe', 'sysprobe.sh')}:Games/sysprobe:755"]
        names = names + ("sysprobe",)
    print("3. Patching a copy of the raw dump (offline)\n   " + " ".join(cmd))
    r = subprocess.run(cmd, capture_output=True, text=True)
    print(r.stdout + r.stderr)
    if r.returncode:
        if "no physical copy" in r.stdout + r.stderr:
            print("The new files landed on disk pages that have never been written, which the in-place patch")
            print("cannot reach. Try --first with --remove of the old C game binaries so their blocks are reused,")
            print("or put the files on the microSD card once the slot is on (GAMEDEV.md § 9).")
        die("staging stopped; nothing was written to the cabinet")
    blocks = open(os.path.join(out, "BLOCKS.txt")).read().strip()
    plan = os.path.join(out, "PLAN.md")
    with open(plan, "w") as f:
        f.write(f"# Deploy plan\n\nRaw dump: `{os.path.abspath(a.raw)}`\n\nFiles:\n\n")
        for n in names:
            new = a.first or n in ("love.tar.gz", "loveprobe", "loveyard", "sysprobe")
            f.write(f"* `/data/Games/{n}` ({'new' if new else 'in place'})\n")
        f.write(f"\nBlocks to write: `{blocks}`\n\nBefore: `rk_restore.py diff` of the raw dump in the same Mask ROM "
                "session must report none. Then, only with the user's written approval of exactly these blocks:\n\n"
                f"```\nPARTYCADE_ALLOW_NAND_WRITE=yes python3 tools/rk_restore.py restore {out}/nand_raw_patched.bin "
                f"--blocks {blocks} --approval '<the user's approval text>'\n```\n")
    print(f"Plan: {plan}\nNothing was written to the cabinet.")


