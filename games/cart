    p.add_argument("--quick", action="store_true", help="skip the callgrind frame cost")
    p = sub.add_parser("shots")
    p.add_argument("id")
    p.add_argument("frames", nargs="*")
    p.add_argument("--auto", action="store_true", help="let the cart's bot() play")
    p = sub.add_parser("perf")
    p.add_argument("id")
    p.add_argument("--frames", type=int, default=600)
    p = sub.add_parser("pack")
    p.add_argument("--out")
    p = sub.add_parser("love-pack")
    p.add_argument("--out")
    p = sub.add_parser("love")
    p.add_argument("id", nargs="?")
